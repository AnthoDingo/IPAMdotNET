@page
@model ErrorModel
@{
    ViewData["Title"] = L.T("Error");
}

<h1 class="text-danger">@L.T("Error.")</h1>
<h2 class="text-danger">@L.T("An error occurred while processing your request.")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L.T("Request ID:")</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@L.T("Development Mode")</h3>
<p>
    @L.T("Swapping to the") <strong>@L.T("Development")</strong> @L.T("environment displays detailed information about the error that occurred.")
</p>
<p>
    <strong>@L.T("The Development environment shouldn't be enabled for deployed applications.")</strong>
    @L.T("It can result in displaying sensitive information from exceptions to end users. For local debugging, enable the") <strong>@L.T("Development")</strong> @L.T("environment by setting the") <strong>ASPNETCORE_ENVIRONMENT</strong> @L.T("environment variable to") <strong>@L.T("Development")</strong>
    @L.T("and restarting the app.")
</p>
