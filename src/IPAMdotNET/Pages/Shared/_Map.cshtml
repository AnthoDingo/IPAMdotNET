@using System.Text.Json
@model IReadOnlyList<MapPoint>
@* Carte Leaflet (bibliothèque locale, tuiles OpenStreetMap) : un marqueur par point, initialisée par site.js. Une seule carte par page. *@

@if (Model.Count > 0)
{
    <link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.css" />
    <script src="~/lib/leaflet/dist/leaflet.js"></script>
    <div class="ipam-map" role="region" aria-label="@L.T("Carte")"
         data-ipam-map="@JsonSerializer.Serialize(Model.Select(p => new { label = p.Label, lat = p.Latitude, lon = p.Longitude, url = p.Url }))"></div>
}
