@using IPAMdotNet.Data
@using IPAMdotNet.Maintenance
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    bool authenticated = User.Identity?.IsAuthenticated == true;
    List<Section> sections = [];
    if (authenticated)
    {
        SectionAccess access = await SectionAccess.ForAsync(Db, User);
        sections = (await Db.Sections.OrderBy(s => s.Name).ToListAsync()).Where(s => access.CanRead(s.Id)).ToList();
    }
    ServerSettings settings = SettingsStore.Server;
    bool isAdmin = User.IsInRole("Admin");
    bool hasSidebar = IsSectionDefined("Sidebar");
    PathString path = Context.Request.Path;
    string? version = typeof(Menus).Assembly.GetName().Version?.ToString(3);
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @settings.SiteTitle</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo.svg" />
    @* Appliqué avant le rendu pour éviter un flash du mauvais thème. *@
    <script>
        (() => {
            let theme = null;
            try { theme = localStorage.getItem("theme"); } catch { }
            if (theme !== "light" && theme !== "dark") {
                theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.setAttribute("data-bs-theme", theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-text-expand="@L.T("Déplier")" data-text-collapse="@L.T("Replier")" data-text-close="@L.T("Fermer")">
    <header class="ipam-header">
        <div class="container-fluid ipam-header-bar">
            <a class="ipam-brand" asp-page="/Index">
                <img src="~/img/logo.svg" alt="" class="ipam-brand-logo" />
                <span class="ipam-brand-name">@settings.SiteTitle</span>
                <span class="ipam-brand-sub d-none d-sm-inline">@L.T("Gestion d'adresses IP")</span>
            </a>
            <div class="ipam-header-tools d-flex align-items-center gap-2">
                @if (authenticated)
                {
                    <form class="ipam-search d-none d-md-flex" role="search" method="get" asp-page="/Tools/Search/Index">
                        <input class="form-control form-control-sm" type="search" name="q" value="@(path.StartsWithSegments("/Tools/Search") ? Context.Request.Query["q"].ToString() : "")" placeholder="@L.T("Rechercher une adresse, un sous-réseau…")" aria-label="@L.T("Rechercher")" />
                        <button class="btn btn-sm ipam-header-btn" type="submit" aria-label="@L.T("Rechercher")"><i class="bi bi-search"></i></button>
                    </form>
                }
                <button type="button" class="btn btn-sm ipam-header-btn" id="theme-toggle" title="@L.T("Changer de thème")" aria-label="@L.T("Changer de thème")">
                    <i class="bi bi-moon-stars theme-icon-dark" aria-hidden="true"></i>
                    <i class="bi bi-sun theme-icon-light" aria-hidden="true"></i>
                </button>
                @if (authenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-sm ipam-header-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i> <span class="d-none d-sm-inline">@User.Identity!.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-page="/Profile/Index"><i class="bi bi-person"></i> @L.T("Mon compte")</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-page="/Account/Logout" class="m-0">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> @L.T("Déconnexion")</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </header>

    @if (authenticated)
    {
        <nav class="ipam-menubar navbar navbar-expand-md py-0">
            <div class="container-fluid">
                <button class="navbar-toggler my-1" type="button" data-bs-toggle="collapse" data-bs-target="#ipam-menu" aria-controls="ipam-menu" aria-expanded="false" aria-label="@L.T("Menu")">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="ipam-menu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(path == "/" || path.StartsWithSegments("/Index") ? "active" : "")" asp-page="/Index"><i class="bi bi-house"></i> @L.T("Tableau de bord")</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(path.StartsWithSegments("/Sections") ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-collection"></i> @L.T("Sections")</a>
                            <ul class="dropdown-menu">
                                @foreach (Section menuSection in sections)
                                {
                                    <li><a class="dropdown-item" asp-page="/Sections/Index" asp-route-id="@menuSection.Id">@menuSection.Name</a></li>
                                }
                                @if (sections.Count == 0)
                                {
                                    <li><span class="dropdown-item-text text-body-secondary">@L.T("Aucune section")</span></li>
                                }
                                @if (isAdmin)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-page="/Administration/Sections/Index"><i class="bi bi-gear"></i> @L.T("Gérer les sections")</a></li>
                                }
                            </ul>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(path.StartsWithSegments("/Tools") || path.StartsWithSegments("/Network") || path.StartsWithSegments("/Infrastructure") ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-tools"></i> @L.T("Outils")</a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item fw-semibold" asp-page="/Tools/Index"><i class="bi bi-grid-1x2"></i> @L.T("Tous les outils")</a>
                                <hr class="dropdown-divider" />
                                <partial name="_MenuDropdown" model="Menus.Tools" />
                            </div>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(path.StartsWithSegments("/Administration") ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-gear-fill"></i> @L.T("Administration")</a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item fw-semibold" asp-page="/Administration/Index"><i class="bi bi-grid-1x2"></i> @L.T("Toute l'administration")</a>
                                    <hr class="dropdown-divider" />
                                    <partial name="_MenuDropdown" model="Menus.Administration" />
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    }

    <div class="container-fluid ipam-body">
        @if (IsSectionDefined("Breadcrumb"))
        {
            <nav aria-label="@L.T("Fil d'Ariane")" class="ipam-breadcrumb">
                <ol class="breadcrumb mb-0">@await RenderSectionAsync("Breadcrumb")</ol>
            </nav>
        }
        <div class="row g-3">
            @if (hasSidebar)
            {
                <aside class="col-lg-3 col-xl-2">
                    <div class="ipam-panel ipam-sidebar">@await RenderSectionAsync("Sidebar")</div>
                </aside>
            }
            <main role="main" class="@(hasSidebar ? "col-lg-9 col-xl-10" : "col-12")">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="ipam-footer">
        <div class="container-fluid">
            IPAM.Net @(version is null ? "" : $"v{version}") &middot; <a href="https://www.gnu.org/licenses/agpl-3.0.html">@L.T("AGPL-3.0-or-later")</a>
            @if (settings.AdminEmail is not null)
            {
                <text>@L.T("· En cas de problème, contactez") <a href="mailto:@settings.AdminEmail">@(settings.AdminName ?? settings.AdminEmail)</a></text>
            }
        </div>
    </footer>

    @* Confirmation des actions [data-ipam-confirm] (site.js), à la place de confirm() du navigateur. *@
    <div class="modal fade ipam-confirm" id="ipam-confirm" tabindex="-1" aria-labelledby="ipam-confirm-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ipam-confirm-title">@L.T("Confirmation")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L.T("Fermer")"></button>
                </div>
                <div class="modal-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L.T("Annuler")</button>
                    <button type="button" class="btn btn-primary" data-ipam-confirm-ok>@L.T("Confirmer")</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
