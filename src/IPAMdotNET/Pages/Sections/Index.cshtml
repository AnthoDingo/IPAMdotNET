@page "{id:int}"
@using IPAMdotNet.Networking
@model IPAMdotNet.Pages.Sections.IndexModel
@{
    ViewData["Title"] = Model.Section.Name;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-page="/Index">@L.T("Tableau de bord")</a></li>
    <li class="breadcrumb-item active" aria-current="page">@Model.Section.Name</li>
}

@section Sidebar {
    <partial name="_SubnetSidebar" model="@(new SubnetSidebar(Model.Section, Model.Tree, null))" />
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-collection"></i> @Model.Section.Name</span>
        @if (Model.CanWrite)
        {
            <a asp-page="/Network/Subnets/Edit" asp-route-sectionId="@Model.Section.Id" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Ajouter un sous-réseau")</a>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.Section.Description))
    {
        <p class="text-body-secondary">@Model.Section.Description</p>
    }
    @if (Model.Tree.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun sous-réseau dans cette section.")</p>
    }
    else
    {
        <partial name="_SubnetTable" model="Model.Tree" />
    }
</div>

@if (Model.Section.Id != 0)
{
    <vc:history entity-type="Section" entity-id="@Model.Section.Id" />
}
