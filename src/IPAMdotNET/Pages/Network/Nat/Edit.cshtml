@page "{id:int?}"
@using IPAMdotNet.Data
@using IPAMdotNet.Maintenance
@model IPAMdotNet.Pages.Network.Nat.EditModel
@{
    ViewData["Title"] = Model.Rule.Id == 0 ? "Nouvelle règle NAT" : $"NAT {Model.Rule.Name}";
}

<div class="ipam-panel ipam-form">
    <div class="ipam-panel-title">@ViewData["Title"]</div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-8">
                <label asp-for="Rule.Name" class="form-label"></label>
                <input asp-for="Rule.Name" class="form-control" />
                <span asp-validation-for="Rule.Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Rule.Type" class="form-label"></label>
                <select asp-for="Rule.Type" asp-items="Html.GetEnumSelectList<NatType>()" class="form-select"></select>
            </div>
            <div class="col-md-8">
                <label asp-for="Source.Text" class="form-label">@L.T("Source")</label>
                <textarea asp-for="Source.Text" class="form-control font-monospace" rows="3" placeholder="10.0.0.0/24"></textarea>
                <span asp-validation-for="Source.Text" class="text-danger"></span>
                <partial name="_LinkedLines" model="@(("Source", Model.Source, false))" />
            </div>
            <div class="col-md-4">
                <label asp-for="Rule.SourcePort" class="form-label"></label>
                <input asp-for="Rule.SourcePort" class="form-control" min="1" max="65535" />
                <span asp-validation-for="Rule.SourcePort" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Destination.Text" class="form-label">@L.T("Destination")</label>
                <textarea asp-for="Destination.Text" class="form-control font-monospace" rows="3" placeholder="203.0.113.10"></textarea>
                <span asp-validation-for="Destination.Text" class="text-danger"></span>
                <partial name="_LinkedLines" model="@(("Destination", Model.Destination, false))" />
            </div>
            <div class="col-md-4">
                <label asp-for="Rule.DestinationPort" class="form-label"></label>
                <input asp-for="Rule.DestinationPort" class="form-control" min="1" max="65535" />
                <span asp-validation-for="Rule.DestinationPort" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Rule.DeviceId" class="form-label"></label>
                <select asp-for="Rule.DeviceId" asp-items="Model.Devices" class="form-select"><option value="">@L.T("Aucun")</option></select>
                <span asp-validation-for="Rule.DeviceId" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Rule.Description" class="form-label"></label>
                <textarea asp-for="Rule.Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Rule.Description" class="text-danger"></span>
            </div>
        </div>
        <partial name="_CustomFieldsEdit" model="Model.CustomInputs" />
        <button type="submit" class="btn btn-primary">@L.T("Enregistrer")</button>
        <a asp-page="Index" class="btn btn-outline-secondary">@L.T("Annuler")</a>
    </form>
    <partial name="_DeleteForm" model="@(new DeleteForm(Model.Rule.Id, "cette règle"))" />
</div>
