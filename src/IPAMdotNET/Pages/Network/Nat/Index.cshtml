@page
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Network.Nat.IndexModel
@{
    ViewData["Title"] = L.T("NAT");
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-arrow-left-right"></i> NAT</span>
        @if (admin)
        {
            <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Ajouter")</a>
        }
    </div>
    @if (Model.Rules.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucune règle NAT.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Nom")</th><th>@L.T("Type")</th><th>@L.T("Source")</th><th></th><th>@L.T("Destination")</th><th>@L.T("Description")</th>@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (NatRule rule in Model.Rules)
                {
                    <tr>
                        <td>@rule.Name</td>
                        <td>@Html.DisplayFor(_ => rule.Type)</td>
                        <td class="font-monospace">@rule.Source@(rule.SourcePort is null ? "" : $":{rule.SourcePort}")</td>
                        <td><i class="bi bi-arrow-right"></i></td>
                        <td class="font-monospace">@rule.Destination@(rule.DestinationPort is null ? "" : $":{rule.DestinationPort}")</td>
                        <td>@rule.Description</td>
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Edit" asp-route-id="@rule.Id" class="btn btn-outline-secondary btn-sm" title="@L.T("Modifier")"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
