@page "{id:int?}"
@model IPAMdotNet.Pages.Network.VlanDomains.EditModel
@{
    ViewData["Title"] = Model.Domain.Id == 0 ? L.T("Nouveau domaine L2") : L.T("Domaine L2 {0}", Model.Domain.Name);
}

<div class="ipam-panel ipam-form">
    <div class="ipam-panel-title">@ViewData["Title"]</div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Domain.Name" class="form-label"></label>
            <input asp-for="Domain.Name" class="form-control" />
            <span asp-validation-for="Domain.Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Domain.Description" class="form-label"></label>
            <textarea asp-for="Domain.Description" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Domain.Description" class="text-danger"></span>
        </div>
        @if (Model.AllSections.Count > 0)
        {
            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold border-bottom pb-1 mb-2">@L.T("Sections")</legend>
                @foreach (IPAMdotNet.Data.Section item in Model.AllSections)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="section-@item.Id" name="SectionIds" value="@item.Id" checked="@Model.SectionIds.Contains(item.Id)" />
                        <label class="form-check-label" for="section-@item.Id">@item.Name</label>
                    </div>
                }
                <div class="form-text">@L.T("Les VLAN du domaine ne sont proposés qu'aux sous-réseaux de ces sections. Aucune : toutes les sections.")</div>
            </fieldset>
        }
        <button type="submit" class="btn btn-primary">@L.T("Enregistrer")</button>
        <a asp-page="Index" class="btn btn-outline-secondary">@L.T("Annuler")</a>
    </form>
    <partial name="_DeleteForm" model="@(new DeleteForm(Model.Domain.Id, L.T("ce domaine L2")))" />
</div>
