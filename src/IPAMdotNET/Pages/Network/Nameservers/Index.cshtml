@page
@model IPAMdotNet.Pages.Network.Nameservers.IndexModel
@{
    ViewData["Title"] = L.T("Serveurs de noms");
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-globe"></i> @L.T("Serveurs de noms")</span>
        @if (admin)
        {
            <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Ajouter")</a>
        }
    </div>
    @if (Model.Nameservers.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun jeu de serveurs de noms.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Nom")</th><th>@L.T("Serveurs")</th><th>@L.T("Description")</th><th class="text-end">@L.T("Sous-réseaux")</th>@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (NameserverRow row in Model.Nameservers)
                {
                    <tr>
                        <td>@row.Nameserver.Name</td>
                        <td class="font-monospace">@row.Nameserver.Servers.Replace(";", ", ")</td>
                        <td>@row.Nameserver.Description</td>
                        <td class="text-end">@row.SubnetCount</td>
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Edit" asp-route-id="@row.Nameserver.Id" class="btn btn-outline-secondary btn-sm" title="@L.T("Modifier")"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
