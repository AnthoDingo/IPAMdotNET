@page "{id:int?}"
@model IPAMdotNet.Pages.Network.Nameservers.EditModel
@{
    ViewData["Title"] = Model.Nameserver.Id == 0 ? L.T("Nouveaux serveurs de noms") : L.T("Serveurs de noms {0}", Model.Nameserver.Name);
}

<div class="ipam-panel ipam-form">
    <div class="ipam-panel-title">@ViewData["Title"]</div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Nameserver.Name" class="form-label"></label>
            <input asp-for="Nameserver.Name" class="form-control" />
            <span asp-validation-for="Nameserver.Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Nameserver.Servers" class="form-label"></label>
            <textarea asp-for="Nameserver.Servers" class="form-control font-monospace" rows="3" placeholder="@L.T("192.0.2.53; 2001:db8::53")"></textarea>
            <div class="form-text">@L.T("Adresses IP séparées par « ; », une virgule ou un retour à la ligne.")</div>
            <span asp-validation-for="Nameserver.Servers" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Nameserver.Description" class="form-label"></label>
            <textarea asp-for="Nameserver.Description" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Nameserver.Description" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">@L.T("Enregistrer")</button>
        <a asp-page="Index" class="btn btn-outline-secondary">@L.T("Annuler")</a>
    </form>
    <partial name="_DeleteForm" model="@(new DeleteForm(Model.Nameserver.Id, L.T("ces serveurs de noms")))" />
</div>
