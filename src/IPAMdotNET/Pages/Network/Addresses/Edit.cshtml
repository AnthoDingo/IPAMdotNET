@page "{id:int?}"
@model IPAMdotNet.Pages.Network.Addresses.EditModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Entry.Id == 0 ? "Nouvelle adresse" : $"Adresse {Model.Ip}";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-page="/Index">Tableau de bord</a></li>
    <li class="breadcrumb-item"><a asp-page="/Sections/Index" asp-route-id="@Model.Subnet.SectionId">@Model.Subnet.Section?.Name</a></li>
    <li class="breadcrumb-item"><a asp-page="/Network/Subnets/Details" asp-route-id="@Model.Subnet.Id">@Model.Subnet.Network</a></li>
    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
}

<div class="ipam-panel ipam-form">
    <div class="ipam-panel-title">@ViewData["Title"] <span class="text-body-secondary font-monospace small">(@Model.Subnet.Network)</span></div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Entry.SubnetId" />
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Ip" class="form-label"></label>
                <input asp-for="Ip" class="form-control font-monospace" />
                <span asp-validation-for="Ip" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Entry.TagId" class="form-label"></label>
                <select asp-for="Entry.TagId" asp-items="Model.Tags" class="form-select"><option value="">Aucune</option></select>
            </div>
            <div class="col-md-6">
                <label asp-for="Entry.Hostname" class="form-label"></label>
                <input asp-for="Entry.Hostname" class="form-control" />
                <span asp-validation-for="Entry.Hostname" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Entry.MacAddress" class="form-label"></label>
                <input asp-for="Entry.MacAddress" class="form-control font-monospace" placeholder="00:11:22:aa:bb:cc" />
                <span asp-validation-for="Entry.MacAddress" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Entry.Owner" class="form-label"></label>
                <input asp-for="Entry.Owner" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Entry.DeviceId" class="form-label"></label>
                <select asp-for="Entry.DeviceId" asp-items="Model.Devices" class="form-select"><option value="">Aucun</option></select>
            </div>
            <div class="col-12">
                <label asp-for="Entry.Description" class="form-label"></label>
                <input asp-for="Entry.Description" class="form-control" />
                <span asp-validation-for="Entry.Description" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="Entry.ExcludePing" class="form-check-input" role="switch" />
                    <label asp-for="Entry.ExcludePing" class="form-check-label"></label>
                </div>
            </div>
        </div>
        <partial name="_CustomFieldsEdit" model="Model.CustomInputs" />
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-page="/Network/Subnets/Details" asp-route-id="@Model.Subnet.Id" class="btn btn-outline-secondary">Annuler</a>
    </form>
    <partial name="_DeleteForm" model="@(new DeleteForm(Model.Entry.Id, "cette adresse"))" />
</div>
