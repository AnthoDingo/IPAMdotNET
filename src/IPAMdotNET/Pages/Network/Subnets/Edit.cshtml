@page "{id:int?}"
@model IPAMdotNet.Pages.Network.Subnets.EditModel
@{
    ViewData["Title"] = Model.Subnet.Id == 0 ? L.T("Nouveau sous-réseau") : L.T("Sous-réseau {0}", Model.Cidr);
}

<div class="ipam-panel ipam-form">
    <div class="ipam-panel-title">@ViewData["Title"]</div>
    @if (Model.Sections.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucune section.") <a asp-page="/Administration/Sections/Edit">@L.T("Créez une section")</a> @L.T("avant d'ajouter des sous-réseaux.")</p>
    }
    else
    {
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Cidr" class="form-label"></label>
                    <input asp-for="Cidr" class="form-control font-monospace" placeholder="10.0.0.0/24" />
                    <div class="form-text">@L.T("La hiérarchie est calculée automatiquement : un sous-réseau est rangé sous le plus petit sous-réseau qui le contient.")</div>
                    <span asp-validation-for="Cidr" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Subnet.SectionId" class="form-label"></label>
                    <select asp-for="Subnet.SectionId" asp-items="Model.Sections" class="form-select"></select>
                    <span asp-validation-for="Subnet.SectionId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Subnet.Description" class="form-label"></label>
                    <input asp-for="Subnet.Description" class="form-control" />
                    <span asp-validation-for="Subnet.Description" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Subnet.VlanId" class="form-label"></label>
                    <select asp-for="Subnet.VlanId" class="form-select">
                        <option value="">@L.T("Aucun")</option>
                        @foreach ((string? domain, string open, List<SelectListItem> vlans) in Model.VlanGroups)
                        {
                            @if (domain is null)
                            {
                                @foreach (SelectListItem vlan in vlans)
                                {
                                    <option value="@vlan.Value" data-sections="@open">@vlan.Text</option>
                                }
                            }
                            else
                            {
                                <optgroup label="@domain">
                                    @foreach (SelectListItem vlan in vlans)
                                    {
                                        <option value="@vlan.Value" data-sections="@open">@vlan.Text</option>
                                    }
                                </optgroup>
                            }
                        }
                    </select>
                    <span asp-validation-for="Subnet.VlanId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Subnet.VrfId" class="form-label"></label>
                    <select asp-for="Subnet.VrfId" asp-items="Model.Vrfs" class="form-select"><option value="">@L.T("Aucune")</option></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Subnet.NameserverId" class="form-label"></label>
                    <select asp-for="Subnet.NameserverId" asp-items="Model.Nameservers" class="form-select"><option value="">@L.T("Aucun")</option></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Subnet.LocationId" class="form-label"></label>
                    <select asp-for="Subnet.LocationId" asp-items="Model.Locations" class="form-select"><option value="">@L.T("Aucun")</option></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Subnet.CustomerId" class="form-label"></label>
                    <select asp-for="Subnet.CustomerId" asp-items="Model.Customers" class="form-select"><option value="">@L.T("Aucun")</option></select>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Subnet.AllowRequests" class="form-check-input" />
                        <label asp-for="Subnet.AllowRequests" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Subnet.PingCheck" class="form-check-input" />
                        <label asp-for="Subnet.PingCheck" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Subnet.Discover" class="form-check-input" />
                        <label asp-for="Subnet.Discover" class="form-check-label"></label>
                        <div class="form-text">@(L.T("La découverte ne s'applique qu'aux sous-réseaux IPv4 d'au plus {0} hôtes.", IPAMdotNet.Maintenance.SubnetScanner.MaxDiscoveryHosts))</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Subnet.ScanAgentId" class="form-label"></label>
                    <select asp-for="Subnet.ScanAgentId" asp-items="Model.Agents" class="form-select"><option value="">@L.T("Agent intégré (serveur)")</option></select>
                    <span asp-validation-for="Subnet.ScanAgentId" class="text-danger"></span>
                </div>
            </div>
            <partial name="_CustomFieldsEdit" model="Model.CustomInputs" />
            <button type="submit" class="btn btn-primary">@L.T("Enregistrer")</button>
            <a asp-page="Index" class="btn btn-outline-secondary">@L.T("Annuler")</a>
        </form>
        <partial name="_DeleteForm" model="@(new DeleteForm(Model.Subnet.Id, L.T("ce sous-réseau et ses adresses")))" />
        <script>
            // VLAN proposés selon la section : domaines L2 sans restriction ou ouverts à la section choisie.
            (() => {
                const section = document.getElementById("Subnet_SectionId");
                const vlan = document.getElementById("Subnet_VlanId");
                const initial = { section: section.value, vlan: vlan.value };
                const update = () => {
                    vlan.querySelectorAll("option[data-sections]").forEach(o => {
                        const open = o.dataset.sections.split(" ").filter(s => s);
                        // Le rattachement d'origine reste proposé dans sa section (il reste valable tant que rien ne change).
                        const kept = section.value === initial.section && o.value === initial.vlan;
                        o.hidden = o.disabled = open.length > 0 && !open.includes(section.value) && !kept;
                    });
                    vlan.querySelectorAll("optgroup").forEach(g => g.hidden = [...g.children].every(o => o.hidden));
                    if (vlan.selectedOptions[0]?.hidden) {
                        vlan.value = "";
                    }
                };
                section.addEventListener("change", update);
                update();
            })();
        </script>
    }
</div>
