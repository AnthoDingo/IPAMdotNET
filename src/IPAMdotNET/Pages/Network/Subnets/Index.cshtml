@page
@model IPAMdotNet.Pages.Network.Subnets.IndexModel
@{
    ViewData["Title"] = "Sous-réseaux";
}

<div class="d-flex align-items-center mb-3">
    <h1 class="h5 mb-0"><i class="bi bi-diagram-3"></i> Tous les sous-réseaux</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> Ajouter</a>
    }
</div>

@if (Model.Sections.Count == 0)
{
    <div class="ipam-panel"><p class="ipam-empty">Aucun sous-réseau.</p></div>
}
else
{
    <partial name="_SectionSubnets" model="Model.Sections" />
}
