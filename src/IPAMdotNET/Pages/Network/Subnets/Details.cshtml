@page "{id:int}"
@using System.Net
@using IPAMdotNet.Data
@using IPAMdotNet.Maintenance
@using IPAMdotNet.Networking
@using IPAMdotNet.Pages.Network.Subnets
@model IPAMdotNet.Pages.Network.Subnets.DetailsModel
@{
    Layout = "_Layout";
    IPNetwork network = Model.Subnet.Network;
    ViewData["Title"] = network.ToString();
    const int RangeModelLimit = IPAMdotNet.Pages.Network.Addresses.RangeModel.MaxAddresses;
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-page="/Index">@L.T("Tableau de bord")</a></li>
    <li class="breadcrumb-item"><a asp-page="/Sections/Index" asp-route-id="@Model.Subnet.SectionId">@Model.Subnet.Section!.Name</a></li>
    @foreach (Subnet ancestor in Model.Ancestors)
    {
        <li class="breadcrumb-item"><a asp-page="Details" asp-route-id="@ancestor.Id">@ancestor.Network</a></li>
    }
    <li class="breadcrumb-item active" aria-current="page">@network</li>
}

@section Sidebar {
    <partial name="_SubnetSidebar" model="@(new SubnetSidebar(Model.Subnet.Section!, Model.Tree, Model.Subnet.Id))" />
}

@if (Model.Message is not null)
{
    <div class="alert alert-info">@Model.Message</div>
}

@{
    // Graphique d'utilisation (comme phpIPAM) : une part par étiquette, le reste est libre.
    System.Numerics.BigInteger usable = Ip.UsableCount(network);
    List<(string Label, string Color, double Percent, string Count)> slices = Model.UsageByTag
        .Select(u => (u.Tag?.Name ?? L.T("Sans étiquette"), u.Tag?.BackgroundColor ?? "var(--bs-secondary-color)",
            usable.IsZero ? 0 : u.Count * 100 / (double)usable, u.Count.ToString("N0")))
        .ToList();
    slices.Add((L.T("Libre"), "var(--ipam-border)", Math.Max(0, 100 - slices.Sum(s => s.Percent)),
        System.Numerics.BigInteger.Max(0, usable - Model.AddressCount).ToString("N0")));
    double start = 0;
    List<string> stops = [];
    foreach ((string Label, string Color, double Percent, string Count) slice in slices)
    {
        stops.Add(FormattableString.Invariant($"{slice.Color} {start:0.###}% {start + slice.Percent:0.###}%"));
        start += slice.Percent;
    }
}
<div class="ipam-panel mb-3">
    <div class="ipam-panel-title d-flex align-items-center">
        <span class="font-monospace"><i class="bi bi-diagram-3"></i> @network</span>
        <form method="post" asp-page-handler="ToggleFavorite" asp-route-id="@Model.Subnet.Id" class="ms-auto me-2">
            <button type="submit" class="btn btn-outline-secondary btn-sm" title="@(Model.IsFavorite ? "Retirer des favoris" : "Ajouter aux favoris")">
                <i class="bi @(Model.IsFavorite ? "bi-star-fill text-warning" : "bi-star")"></i>@L.T("Favori")
            </button>
        </form>
        @if (Model.CanWrite)
        {
            <a asp-page="Edit" asp-route-id="@Model.Subnet.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i> @L.T("Modifier")</a>
        }
    </div>
    <div class="row g-3">
        <div class="col-lg-8 col-xxl-9">
            <dl class="row mb-0 ipam-details">
                <dt class="col-sm-4 col-xl-3">@L.T("Description")</dt>
                <dd class="col-sm-8 col-xl-9">@(Model.Subnet.Description ?? "—")</dd>
                <dt class="col-sm-4 col-xl-3">@L.T("Adresse réseau")</dt>
                <dd class="col-sm-8 col-xl-9 font-monospace">@network.BaseAddress</dd>
                @if (Model.Subnet.IsIPv4)
                {
                    <dt class="col-sm-4 col-xl-3">@L.T("Masque")</dt>
                    <dd class="col-sm-8 col-xl-9 font-monospace">@Ip.Ipv4Mask(network.PrefixLength) (/@network.PrefixLength)</dd>
                    <dt class="col-sm-4 col-xl-3">@L.T("Diffusion")</dt>
                    <dd class="col-sm-8 col-xl-9 font-monospace">@Ip.LastAddress(network)</dd>
                }
                else
                {
                    <dt class="col-sm-4 col-xl-3">@L.T("Dernière adresse")</dt>
                    <dd class="col-sm-8 col-xl-9 font-monospace">@Ip.LastAddress(network)</dd>
                }
                <dt class="col-sm-4 col-xl-3">@L.T("Nombre d'adresses")</dt>
                <dd class="col-sm-8 col-xl-9">@Ip.AddressCount(network).ToString("N0")</dd>
                <dt class="col-sm-4 col-xl-3">@L.T("Utilisation")</dt>
                <dd class="col-sm-8 col-xl-9"><div style="max-width: 24rem"><partial name="_UsageBar" model="(Model.AddressCount, Ip.UsableCount(network))" /></div></dd>
                <dt class="col-sm-4 col-xl-3">@L.T("Scan")</dt>
                <dd class="col-sm-8 col-xl-9">
                    @if (!Model.Subnet.PingCheck && !Model.Subnet.Discover)
                    {
                        <text>@L.T("Désactivé pour ce sous-réseau")</text>
                    }
                    else
                    {
                        @string.Join(" + ", new[] { Model.Subnet.PingCheck ? "état des hôtes" : null, Model.Subnet.Discover ? "découverte" : null }.Where(s => s is not null))
                        <span class="text-body-secondary">— @(Model.Subnet.ScanAgent is null ? "agent intégré" : $"agent « {Model.Subnet.ScanAgent.Name} »"), dernier scan : @(Model.Subnet.LastScanAt?.ToLocalTime().ToString("g") ?? "jamais")</span>
                        @if (!Model.ScanEnabled)
                        {
                            <span class="badge text-bg-warning">@L.T("agent désactivé")</span>
                        }
                    }
                </dd>
                <dt class="col-sm-4 col-xl-3">VLAN</dt>
                <dd class="col-sm-8 col-xl-9">@(Model.Subnet.Vlan is null ? "—" : $"{Model.Subnet.Vlan.Number} – {Model.Subnet.Vlan.Name}")</dd>
                <dt class="col-sm-4 col-xl-3">VRF</dt>
                <dd class="col-sm-8 col-xl-9">@(Model.Subnet.Vrf?.Name ?? "—")</dd>
                <dt class="col-sm-4 col-xl-3">@L.T("Serveurs de noms")</dt>
                <dd class="col-sm-8 col-xl-9">
                    @if (Model.Subnet.Nameserver is null)
                    {
                        <text>—</text>
                    }
                    else
                    {
                        @Model.Subnet.Nameserver.Name <span class="font-monospace text-body-secondary">(@Model.Subnet.Nameserver.Servers.Replace(";", ", "))</span>
                    }
                </dd>
                <dt class="col-sm-4 col-xl-3">@L.T("Emplacement")</dt>
                <dd class="col-sm-8 col-xl-9">
                    @if (Model.Subnet.Location is null) { <text>—</text> }
                    else { <a asp-page="/Infrastructure/Locations/Details" asp-route-id="@Model.Subnet.Location.Id">@Model.Subnet.Location.Name</a> }
                </dd>
                <dt class="col-sm-4 col-xl-3">@L.T("Demandes d'adresses")</dt>
                <dd class="col-sm-8 col-xl-9">
                    @if (Model.Subnet.AllowRequests && IPAMdotNet.Maintenance.SettingsStore.Server.EnableIpRequests)
                    {
                        <a asp-page="/Tools/Requests/New" asp-route-subnetId="@Model.Subnet.Id"><i class="bi bi-inbox"></i>@L.T("Demander une adresse")</a>
                    }
                    else
                    {
                        <text>@L.T("Fermé")</text>
                    }
                </dd>
                <dt class="col-sm-4 col-xl-3">@L.T("Client")</dt>
                <dd class="col-sm-8 col-xl-9">
                    @if (Model.Subnet.Customer is null) { <text>—</text> }
                    else { <a asp-page="/Infrastructure/Customers/Details" asp-route-id="@Model.Subnet.Customer.Id">@Model.Subnet.Customer.Name</a> }
                </dd>
                <partial name="_CustomFieldsDisplay" model="Model.CustomFieldValues" />
            </dl>
        </div>
        <div class="col-lg-4 col-xxl-3 d-flex flex-column align-items-center gap-3">
            <div class="ipam-usage-chart" style="background: conic-gradient(@string.Join(", ", stops))" role="img"
                 aria-label="@L.T("{0} adresse(s) utilisée(s) sur {1}", Model.AddressCount.ToString("N0"), usable.ToString("N0"))"></div>
            <ul class="list-unstyled mb-0 small">
                @foreach ((string Label, string Color, double Percent, string Count) slice in slices)
                {
                    <li>
                        <span class="ipam-usage-swatch" style="background: @slice.Color"></span>
                        @slice.Label : @slice.Count
                        <span class="text-body-secondary">(@(slice.Percent > 0 && slice.Percent < 0.1 ? "< " + 0.1.ToString("0.#") : slice.Percent.ToString("0.#")) %)</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@if (Model.Grid.Count > 0)
{
    <div class="ipam-panel mb-3">
        <div class="ipam-panel-title"><i class="bi bi-grid-3x3"></i> @L.T("Affichage visuel")</div>
        <div class="ipam-ipgrid">
            @foreach (GridCell cell in Model.Grid)
            {
                byte octet = cell.Address.GetAddressBytes()[3];
                if (cell.Entry is IpAddress entry)
                {
                    string title = string.Join(" — ", new[] { cell.Address.ToString(), entry.Tag?.Name, entry.Hostname, entry.Description }.Where(s => !string.IsNullOrEmpty(s)));
                    <a href="@(Model.CanWrite ? Url.Page("/Network/Addresses/Edit", new { id = entry.Id }) : $"#address-{entry.Id}")" data-ipam-modal="@(Model.CanWrite ? "" : null)" class="ipam-ip-used" title="@title"
                       style="@(entry.Tag is null ? null : $"background-color: {entry.Tag.BackgroundColor}; color: {entry.Tag.TextColor}")">@octet</a>
                }
                else if (!cell.Usable)
                {
                    <span class="ipam-ip-reserved" title="@cell.Address — non attribuable">@octet</span>
                }
                else if (Model.CanWrite)
                {
                    <a asp-page="/Network/Addresses/Edit" asp-route-subnetId="@Model.Subnet.Id" asp-route-ip="@cell.Address" data-ipam-modal class="ipam-ip-free" title="@cell.Address — libre">@octet</a>
                }
                else
                {
                    <span class="ipam-ip-free" title="@cell.Address — libre">@octet</span>
                }
            }
        </div>
        <div class="d-flex flex-wrap gap-3 small text-body-secondary mt-2">
            <span><span class="ipam-swatch ipam-ip-free"></span>@L.T("Libre")</span>
            <span><span class="ipam-swatch ipam-ip-reserved"></span>@L.T("Non attribuable")</span>
            @foreach (Tag? tag in Model.GridTags)
            {
                if (tag is null)
                {
                    <span><span class="ipam-swatch ipam-ip-used"></span>@L.T("Sans étiquette")</span>
                }
                else
                {
                    <span title="@tag.Description"><span class="ipam-swatch" style="background-color: @tag.BackgroundColor"></span>@tag.Name</span>
                }
            }
        </div>
    </div>
}

<div class="ipam-panel mb-3">
    <div class="ipam-panel-title d-flex align-items-center gap-2">
        <span><i class="bi bi-list-ul"></i> @(L.T("Adresses ({0})", Model.AddressCount))</span>
        @if (Model.CanWrite && Model.ScanEnabled && (Model.Subnet.PingCheck || Model.Subnet.Discover))
        {
            <form method="post" asp-page-handler="Scan" asp-route-id="@Model.Subnet.Id" class="ms-auto">
                <button type="submit" class="btn btn-outline-secondary btn-sm" onclick="this.disabled = true; this.form.submit();"><i class="bi bi-broadcast-pin"></i>@L.T("Scanner maintenant")</button>
            </form>
        }
        @if (Model.CanWrite)
        {
            <a asp-page="/Network/Addresses/Edit" asp-route-subnetId="@Model.Subnet.Id" data-ipam-modal class="btn btn-primary btn-sm @(Model.ScanEnabled && (Model.Subnet.PingCheck || Model.Subnet.Discover) ? "" : "ms-auto")"><i class="bi bi-plus-lg"></i> @L.T("Ajouter une adresse")</a>
            <a asp-page="/Network/Addresses/Range" asp-route-subnetId="@Model.Subnet.Id" data-ipam-modal class="btn btn-outline-primary btn-sm"><i class="bi bi-plus-square-dotted"></i>@L.T("Ajouter une plage")</a>
        }
    </div>
    @if (Model.FirstFree is not null)
    {
        <p class="small text-body-secondary mb-2">@L.T("Première adresse libre :") <span class="font-monospace">@Model.FirstFree</span></p>
    }
    <partial name="_CustomFieldFilter" model="Model.AddressFilter" />
    @if (Model.Rows.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucune adresse.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr>@if (Model.CanWrite) { <th class="text-center"><input type="checkbox" class="form-check-input" title="@L.T("Tout sélectionner")" onclick="document.querySelectorAll('input[form=address-bulk]').forEach(c => c.checked = this.checked)" /></th> }<th>@L.T("Adresse")</th><th>@L.T("Étiquette")</th><th>@L.T("Nom d'hôte")</th><th>@L.T("Description")</th><th>MAC</th><th>@L.T("Propriétaire")</th><th>@L.T("Équipement")</th>@foreach (CustomField field in Model.AddressFields) { <th>@field.Name</th> }<th>@L.T("Vue le")</th>@if (Model.CanWrite) { <th></th> }</tr></thead>
            <tbody>
                @foreach (object item in Model.Rows)
                {
                    if (item is FreeRange free)
                    {
                        <tr>
                            @if (Model.CanWrite)
                            {
                                <td></td>
                            }
                            <td class="font-monospace text-nowrap text-body-secondary">
                                @free.First
                                @if (free.Count > 1)
                                {
                                    <text>– </text>@free.Last
                                }
                            </td>
                            <td colspan="@(7 + Model.AddressFields.Count)" class="text-body-secondary fst-italic">@free.Count.ToString("N0") @(free.Count > 1 ? "adresses libres" : "adresse libre")</td>
                            @if (Model.CanWrite)
                            {
                                <td class="text-end">
                                    <a asp-page="/Network/Addresses/Edit" asp-route-subnetId="@Model.Subnet.Id" asp-route-ip="@free.First" data-ipam-modal class="btn btn-outline-secondary btn-sm" title="Ajouter @free.First"><i class="bi bi-plus-lg"></i></a>
                                    @if (free.Count > 1)
                                    {
                                        <a asp-page="/Network/Addresses/Range" asp-route-subnetId="@Model.Subnet.Id" asp-route-first="@free.First" asp-route-last="@(free.Count <= RangeModelLimit ? free.Last.ToString() : null)" data-ipam-modal class="btn btn-outline-secondary btn-sm" title="@L.T("Ajouter la plage")"><i class="bi bi-plus-square-dotted"></i></a>
                                    }
                                </td>
                            }
                        </tr>
                        continue;
                    }
                    AddressRow row = (AddressRow)item;
                    IpAddress address = row.First;
                    <tr id="address-@address.Id">
                        @if (Model.CanWrite)
                        {
                            <td class="text-center"><input type="checkbox" class="form-check-input" form="address-bulk" name="Ids" value="@string.Join(",", row.Ids)" aria-label="@L.T("Sélectionner")" /></td>
                        }
                        <td class="font-monospace text-nowrap">
                            @if (row.Count > 1)
                            {
                                @address.Value<text> – </text>@row.Last.Value <span class="text-body-secondary small">(@row.Count)</span>
                            }
                            else
                            {
                                @address.Value
                            }
                        </td>
                        <td>@if (address.Tag is not null && address.Tag.ShowTag) { <partial name="_TagBadge" model="address.Tag" /> }</td>
                        @if (row.Count > 1)
                        {
                            <td colspan="@(5 + Model.AddressFields.Count)" class="text-body-secondary">@L.T("Plage regroupée")</td>
                        }
                        else
                        {
                            <td>@address.Hostname</td>
                            <td>@address.Description</td>
                            <td class="font-monospace small">@User.FormatMac(address.MacAddress)</td>
                            <td>@address.Owner</td>
                            <td>@if (address.Device is not null) { <a asp-page="/Infrastructure/Devices/Details" asp-route-id="@address.Device.Id">@address.Device.Hostname</a> }</td>
                            @foreach (CustomField field in Model.AddressFields)
                            {
                                <td>@CustomFieldForm.Display(field, Model.AddressValues.GetValueOrDefault(address.Id)?.GetValueOrDefault(field.Id))</td>
                            }
                        }
                        <td class="small text-nowrap">@(address.ExcludePing ? "exclue" : address.LastSeen?.ToLocalTime().ToString("g"))</td>
                        @if (Model.CanWrite)
                        {
                            <td class="text-end">
                                @if (row.Count == 1)
                                {
                                    <a asp-page="/Network/Addresses/Edit" asp-route-id="@address.Id" data-ipam-modal class="btn btn-outline-secondary btn-sm" title="@L.T("Modifier")"><i class="bi bi-pencil"></i></a>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.CanWrite && Model.AddressCount > 0)
        {
            <form method="post" id="address-bulk" asp-page="/Network/Addresses/Bulk" asp-route-subnetId="@Model.Subnet.Id" class="d-flex gap-2 mt-2">
                <span class="small text-body-secondary align-self-center">@L.T("Sélection :")</span>
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil-square"></i>@L.T("Modifier")</button>
                <button type="submit" asp-page-handler="Delete" class="btn btn-outline-danger btn-sm" data-ipam-confirm="@L.T("Supprimer les adresses sélectionnées ?")"><i class="bi bi-trash"></i>@L.T("Supprimer")</button>
            </form>
        }
    }
</div>

<div class="ipam-panel">
    <div class="ipam-panel-title"><i class="bi bi-diagram-2"></i> @L.T("Sous-réseaux contenus")</div>
    @if (Model.Descendants.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun sous-réseau contenu.")</p>
    }
    else
    {
        <partial name="_SubnetTable" model="Model.Descendants" />
    }
</div>

@if (Model.BgpPeers.Count > 0)
{
    <div class="ipam-panel mt-3">
        <div class="ipam-panel-title"><i class="bi bi-signpost-split"></i> BGP</div>
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Pair")</th><th>@L.T("Sens")</th><th>@L.T("AS du pair")</th><th>@L.T("Adresse du pair")</th></tr></thead>
            <tbody>
                @foreach (BgpPeerSubnet link in Model.BgpPeers)
                {
                    <tr>
                        <td><a asp-page="/Network/Routing/Index">@link.BgpPeer!.Name</a></td>
                        <td>@Html.DisplayFor(_ => link.Direction)</td>
                        <td>@link.BgpPeer.PeerAs</td>
                        <td class="font-monospace">@link.BgpPeer.PeerAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.NatRules.Count > 0)
{
    <div class="ipam-panel mt-3">
        <div class="ipam-panel-title"><i class="bi bi-arrow-left-right"></i> NAT</div>
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Nom")</th><th>@L.T("Type")</th><th>@L.T("Source")</th><th></th><th>@L.T("Destination")</th></tr></thead>
            <tbody>
                @foreach (NatRule rule in Model.NatRules)
                {
                    <tr>
                        <td><a asp-page="/Network/Nat/Index">@rule.Name</a></td>
                        <td>@Html.DisplayFor(_ => rule.Type)</td>
                        <td class="font-monospace"><partial name="/Pages/Network/Nat/_NatSide.cshtml" model="@((rule.Sources, rule.SourcePort))" /></td>
                        <td><i class="bi bi-arrow-right"></i></td>
                        <td class="font-monospace"><partial name="/Pages/Network/Nat/_NatSide.cshtml" model="@((rule.Destinations, rule.DestinationPort))" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Subnet.Id != 0)
{
    <vc:history entity-type="Subnet" entity-id="@Model.Subnet.Id" />
}
