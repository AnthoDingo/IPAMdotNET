@page
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Network.Routing.IndexModel
@{
    ViewData["Title"] = L.T("Routage BGP");
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-signpost-split"></i> @L.T("Pairs BGP")</span>
        @if (admin)
        {
            <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Ajouter")</a>
        }
    </div>
    <partial name="_CustomFieldFilter" model="Model.Custom" />
    @if (Model.Peers.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun pair BGP.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Pair")</th><th>@L.T("Type")</th><th>@L.T("AS local")</th><th>@L.T("Adresse locale")</th><th>@L.T("AS du pair")</th><th>@L.T("Adresse du pair")</th><th>VRF</th><th>@L.T("Annoncés")</th><th>@L.T("Reçus")</th><th>@L.T("Description")</th>@foreach (CustomField field in Model.Custom.Fields) { <th>@field.Name</th> }@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (BgpPeer peer in Model.Peers)
                {
                    <tr>
                        <td>@peer.Name</td>
                        <td><span class="badge text-bg-secondary">@peer.Type</span></td>
                        <td>@peer.LocalAs</td>
                        <td class="font-monospace">@peer.LocalAddress</td>
                        <td>@peer.PeerAs</td>
                        <td class="font-monospace">@peer.PeerAddress</td>
                        <td>@peer.Vrf?.Name</td>
                        @foreach (BgpDirection direction in new[] { BgpDirection.Advertised, BgpDirection.Received })
                        {
                            <td class="font-monospace small">
                                @foreach (Subnet subnet in Model.Subnets[(peer.Id, direction)])
                                {
                                    <div><a asp-page="/Network/Subnets/Details" asp-route-id="@subnet.Id">@subnet.Network</a></div>
                                }
                            </td>
                        }
                        <td>@peer.Description</td>
                        @foreach (CustomField field in Model.Custom.Fields)
                        {
                            <td>@Model.Custom.Display(peer.Id, field)</td>
                        }
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Edit" asp-route-id="@peer.Id" class="btn btn-outline-secondary btn-sm" title="@L.T("Modifier")"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
