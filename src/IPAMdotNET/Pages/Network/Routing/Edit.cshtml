@page "{id:int?}"
@model IPAMdotNet.Pages.Network.Routing.EditModel
@{
    ViewData["Title"] = Model.Peer.Id == 0 ? "Nouveau pair BGP" : $"Pair BGP {Model.Peer.Name}";
}

<div class="ipam-panel ipam-form">
    <div class="ipam-panel-title">@ViewData["Title"]</div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-8">
                <label asp-for="Peer.Name" class="form-label"></label>
                <input asp-for="Peer.Name" class="form-control" />
                <span asp-validation-for="Peer.Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Peer.VrfId" class="form-label"></label>
                <select asp-for="Peer.VrfId" asp-items="Model.Vrfs" class="form-select">
                    <option value="">@L.T("Aucune (table globale)")</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Peer.LocalAs" class="form-label"></label>
                <input asp-for="Peer.LocalAs" class="form-control" min="1" />
                <span asp-validation-for="Peer.LocalAs" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Peer.LocalAddress" class="form-label"></label>
                <input asp-for="Peer.LocalAddress" class="form-control font-monospace" />
                <span asp-validation-for="Peer.LocalAddress" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Peer.PeerAs" class="form-label"></label>
                <input asp-for="Peer.PeerAs" class="form-control" min="1" />
                <span asp-validation-for="Peer.PeerAs" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Peer.PeerAddress" class="form-label"></label>
                <input asp-for="Peer.PeerAddress" class="form-control font-monospace" />
                <span asp-validation-for="Peer.PeerAddress" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Advertised.Text" class="form-label">@L.T("Sous-réseaux annoncés")</label>
                <textarea asp-for="Advertised.Text" class="form-control font-monospace" rows="3" placeholder="10.0.0.0/24"></textarea>
                <span asp-validation-for="Advertised.Text" class="text-danger"></span>
                <partial name="_LinkedLines" model="@(("Advertised", Model.Advertised, true))" />
            </div>
            <div class="col-md-6">
                <label asp-for="Received.Text" class="form-label">@L.T("Sous-réseaux reçus")</label>
                <textarea asp-for="Received.Text" class="form-control font-monospace" rows="3" placeholder="0.0.0.0/0"></textarea>
                <span asp-validation-for="Received.Text" class="text-danger"></span>
                <partial name="_LinkedLines" model="@(("Received", Model.Received, true))" />
            </div>
            <div class="col-12">
                <label asp-for="Peer.Description" class="form-label"></label>
                <textarea asp-for="Peer.Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Peer.Description" class="text-danger"></span>
            </div>
        </div>
        <p class="form-text">@L.T("Le type (iBGP / eBGP) est déduit : iBGP si les deux AS sont identiques.")</p>
        <partial name="_CustomFieldsEdit" model="Model.CustomInputs" />
        <button type="submit" class="btn btn-primary">@L.T("Enregistrer")</button>
        <a asp-page="Index" class="btn btn-outline-secondary">@L.T("Annuler")</a>
    </form>
    <partial name="_DeleteForm" model="@(new DeleteForm(Model.Peer.Id, "ce pair"))" />
</div>
