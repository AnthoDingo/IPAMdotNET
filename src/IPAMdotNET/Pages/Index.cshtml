@page
@using IPAMdotNet.Data
@model IndexModel
@{
    ViewData["Title"] = "Tableau de bord";
}

@* Widgets du tableau de bord de phpIPAM. Les Top 10 attendent la gestion des adresses IP. *@
<div class="row g-3">
    <div class="col-lg-6 col-xxl-4">
        <div class="ipam-panel h-100">
            <div class="ipam-panel-title"><i class="bi bi-bar-chart"></i> Statistiques</div>
            <table class="table table-sm mb-0">
                <tbody>
                    <tr><th scope="row"><a asp-page="/Administration/Sections/Index">Sections</a></th><td class="text-end">@Model.SectionCount</td></tr>
                    <tr><th scope="row"><a asp-page="/Network/Subnets/Index">Sous-réseaux</a></th><td class="text-end">@Model.SubnetCount</td></tr>
                    <tr><th scope="row">Adresses IP</th><td class="text-end text-body-secondary">—</td></tr>
                    <tr><th scope="row"><a asp-page="/Network/Vlans/Index">VLAN</a></th><td class="text-end">@Model.VlanCount</td></tr>
                    <tr><th scope="row"><a asp-page="/Network/Vrfs/Index">VRF</a></th><td class="text-end">@Model.VrfCount</td></tr>
                    <tr><th scope="row"><a asp-page="/Infrastructure/Devices/Index">Équipements</a></th><td class="text-end">@Model.DeviceCount</td></tr>
                    <tr><th scope="row">Utilisateurs</th><td class="text-end">@Model.UserCount</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-6 col-xxl-4">
        <div class="ipam-panel h-100">
            <div class="ipam-panel-title"><i class="bi bi-star"></i> <a asp-page="/Tools/Favorites/Index">Sous-réseaux favoris</a></div>
            @if (Model.Favorites.Count == 0)
            {
                <p class="ipam-empty">Aucun sous-réseau favori.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (Subnet subnet in Model.Favorites)
                    {
                        <li><a class="font-monospace" asp-page="/Network/Subnets/Details" asp-route-id="@subnet.Id">@subnet.Network</a> <span class="text-body-secondary">@subnet.Description</span></li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col-lg-6 col-xxl-4">
        <div class="ipam-panel h-100">
            <div class="ipam-panel-title"><i class="bi bi-inbox"></i> <a asp-page="/Tools/Requests/Index">Demandes d'adresses</a>
                @if (Model.PendingRequestCount > 0)
                {
                    <span class="badge text-bg-warning ms-1">@Model.PendingRequestCount</span>
                }
            </div>
            @if (Model.PendingRequests.Count == 0)
            {
                <p class="ipam-empty">Aucune demande en attente.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (IpRequest request in Model.PendingRequests)
                    {
                        <li>
                            <span class="font-monospace">@request.Subnet?.Network</span>
                            <span class="text-body-secondary">@request.Description</span>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-page="/Tools/Requests/Process" asp-route-id="@request.Id">traiter</a>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col-lg-6 col-xxl-4">
        <div class="ipam-panel h-100">
            <div class="ipam-panel-title"><i class="bi bi-diagram-3"></i> Top 10 sous-réseaux IPv4</div>
            <p class="ipam-empty">Aucun sous-réseau IPv4.</p>
        </div>
    </div>
    <div class="col-lg-6 col-xxl-4">
        <div class="ipam-panel h-100">
            <div class="ipam-panel-title"><i class="bi bi-diagram-3"></i> Top 10 sous-réseaux IPv6</div>
            <p class="ipam-empty">Aucun sous-réseau IPv6.</p>
        </div>
    </div>
    <div class="col-lg-6 col-xxl-4">
        <div class="ipam-panel h-100">
            <div class="ipam-panel-title"><i class="bi bi-clock-history"></i> <a asp-page="/Tools/Changelog/Index">Dernières modifications</a></div>
            @if (Model.LastChanges.Count == 0)
            {
                <p class="ipam-empty">Aucune modification enregistrée.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0 small">
                    @foreach (ChangeLog change in Model.LastChanges)
                    {
                        string label = ChangeLog.Types.TryGetValue(change.EntityType, out (string Label, string Page, bool HasDetails) type) ? type.Label : change.EntityType;
                        <li>
                            <span class="text-body-secondary">@change.Date.ToLocalTime().ToString("g")</span>
                            @change.UserName · @Html.DisplayFor(_ => change.Action) · @label <strong>@change.EntityLabel</strong>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
