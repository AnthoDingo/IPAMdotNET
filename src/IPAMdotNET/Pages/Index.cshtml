@page
@using IPAMdotNet.Data
@using IPAMdotNet.Maintenance
@model IndexModel
@{
    ViewData["Title"] = L.T("Tableau de bord");
    WidgetSettings widgets = Model.Widgets;
}

@* Widgets du tableau de bord de phpIPAM, affichés selon Administration › Widgets. Top 10 : IPv4 par taux d'occupation, IPv6 par nombre d'adresses. *@
<div class="row g-3">
    @if (widgets.IsVisible("statistics"))
    {
        <div class="col-lg-6 col-xxl-4">
            <div class="ipam-panel h-100">
                <div class="ipam-panel-title"><i class="bi bi-bar-chart"></i> @L.T("Statistiques")</div>
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><th scope="row">@L.T("Sections")</th><td class="text-end">@Model.SectionCount</td></tr>
                        <tr><th scope="row"><a asp-page="/Network/Subnets/Index">@L.T("Sous-réseaux")</a></th><td class="text-end">@Model.SubnetCount</td></tr>
                        <tr><th scope="row">@L.T("Adresses IP")</th><td class="text-end">@Model.AddressCount</td></tr>
                        <tr><th scope="row"><a asp-page="/Network/Vlans/Index">VLAN</a></th><td class="text-end">@Model.VlanCount</td></tr>
                        <tr><th scope="row"><a asp-page="/Network/Vrfs/Index">VRF</a></th><td class="text-end">@Model.VrfCount</td></tr>
                        <tr><th scope="row"><a asp-page="/Infrastructure/Devices/Index">@L.T("Équipements")</a></th><td class="text-end">@Model.DeviceCount</td></tr>
                        <tr><th scope="row">@L.T("Utilisateurs")</th><td class="text-end">@Model.UserCount</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
    @if (widgets.IsVisible("favorites"))
    {
        <div class="col-lg-6 col-xxl-4">
            <div class="ipam-panel h-100">
                <div class="ipam-panel-title"><i class="bi bi-star"></i> <a asp-page="/Tools/Favorites/Index">@L.T("Sous-réseaux favoris")</a></div>
                @if (Model.Favorites.Count == 0)
                {
                    <p class="ipam-empty">@L.T("Aucun sous-réseau favori.")</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (Subnet subnet in Model.Favorites)
                        {
                            <li><a class="font-monospace" asp-page="/Network/Subnets/Details" asp-route-id="@subnet.Id">@subnet.Network</a> <span class="text-body-secondary">@subnet.Description</span></li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
    @if (widgets.IsVisible("requests") && SettingsStore.Server.EnableIpRequests)
    {
        <div class="col-lg-6 col-xxl-4">
            <div class="ipam-panel h-100">
                <div class="ipam-panel-title"><i class="bi bi-inbox"></i> <a asp-page="/Tools/Requests/Index">@L.T("Demandes d'adresses")</a>
                    @if (Model.PendingRequestCount > 0)
                    {
                        <span class="badge text-bg-warning ms-1">@Model.PendingRequestCount</span>
                    }
                </div>
                @if (Model.PendingRequests.Count == 0)
                {
                    <p class="ipam-empty">@L.T("Aucune demande en attente.")</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (IpRequest request in Model.PendingRequests)
                        {
                            <li>
                                <span class="font-monospace">@request.Subnet?.Network</span>
                                <span class="text-body-secondary">@request.Description</span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-page="/Tools/Requests/Process" asp-route-id="@request.Id">@L.T("traiter")</a>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
    @if (widgets.IsVisible("top-ipv4"))
    {
        <div class="col-lg-6 col-xxl-4">
            <div class="ipam-panel h-100">
                <div class="ipam-panel-title"><i class="bi bi-diagram-3"></i> @L.T("Top 10 sous-réseaux IPv4")</div>
                @if (Model.TopIpv4.Count == 0)
                {
                    <p class="ipam-empty">@L.T("Aucune adresse dans un sous-réseau IPv4.")</p>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        @foreach (IPAMdotNet.Networking.SubnetNode node in Model.TopIpv4)
                        {
                            <tr>
                                <td class="font-monospace"><a asp-page="/Network/Subnets/Details" asp-route-id="@node.Subnet.Id">@node.Subnet.Network</a></td>
                                <td style="width: 55%"><partial name="_UsageBar" model="(node.Used, IPAMdotNet.Networking.Ip.UsableCount(node.Subnet.Network))" /></td>
                            </tr>
                        }
                    </table>
                }            </div>
        </div>
    }
    @if (widgets.IsVisible("top-ipv6"))
    {
        <div class="col-lg-6 col-xxl-4">
            <div class="ipam-panel h-100">
                <div class="ipam-panel-title"><i class="bi bi-diagram-3"></i> @L.T("Top 10 sous-réseaux IPv6")</div>
                @if (Model.TopIpv6.Count == 0)
                {
                    <p class="ipam-empty">@L.T("Aucune adresse dans un sous-réseau IPv6.")</p>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        @foreach (IPAMdotNet.Networking.SubnetNode node in Model.TopIpv6)
                        {
                            <tr>
                                <td class="font-monospace"><a asp-page="/Network/Subnets/Details" asp-route-id="@node.Subnet.Id">@node.Subnet.Network</a></td>
                                <td style="width: 55%"><partial name="_UsageBar" model="(node.Used, IPAMdotNet.Networking.Ip.UsableCount(node.Subnet.Network))" /></td>
                            </tr>
                        }
                    </table>
                }            </div>
        </div>
    }
    @if (widgets.IsVisible("changes"))
    {
        <div class="col-lg-6 col-xxl-4">
            <div class="ipam-panel h-100">
                <div class="ipam-panel-title"><i class="bi bi-clock-history"></i> <a asp-page="/Tools/Changelog/Index">@L.T("Dernières modifications")</a></div>
                @if (Model.LastChanges.Count == 0)
                {
                    <p class="ipam-empty">@L.T("Aucune modification enregistrée.")</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 small">
                        @foreach (ChangeLog change in Model.LastChanges)
                        {
                            string label = ChangeLog.Types.TryGetValue(change.EntityType, out (string Label, string Page, bool HasDetails) type) ? L.T(type.Label) : change.EntityType;
                            <li>
                                <span class="text-body-secondary">@change.Date.ToLocalTime().ToString("g")</span>
                                @change.UserName · @Html.DisplayFor(_ => change.Action) · @label <strong>@change.EntityLabel</strong>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>
