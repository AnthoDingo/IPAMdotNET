@page
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Tools.Requests.IndexModel
@{
    ViewData["Title"] = L.T("Demandes d'adresses");
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel mb-3">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-inbox"></i> @(admin ? "Demandes en attente" : "Mes demandes en attente")</span>
        <a asp-page="New" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Nouvelle demande")</a>
    </div>
    @if (Model.Pending.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucune demande en attente.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Date")</th><th>@L.T("Demandeur")</th><th>@L.T("Sous-réseau")</th><th>@L.T("Adresse souhaitée")</th><th>@L.T("Nom d'hôte")</th><th>@L.T("Motif")</th>@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (IpRequest request in Model.Pending)
                {
                    <tr>
                        <td class="text-nowrap">@request.RequestedAt.ToLocalTime().ToString("g")</td>
                        <td>@request.RequesterName</td>
                        <td class="font-monospace"><a asp-page="/Network/Subnets/Details" asp-route-id="@request.SubnetId">@request.Subnet?.Network</a></td>
                        <td class="font-monospace">@request.RequestedAddress@if (request.Count > 1) { <span class="badge text-bg-secondary ms-1">× @request.Count</span> }</td>
                        <td>@request.Hostname</td>
                        <td>@request.Description</td>
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Process" asp-route-id="@request.Id" class="btn btn-outline-primary btn-sm">@L.T("Traiter")</a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="ipam-panel">
    <div class="ipam-panel-title"><i class="bi bi-archive"></i> @L.T("Demandes traitées")</div>
    @if (Model.Processed.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucune demande traitée.")</p>
    }
    else
    {
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>@L.T("Traitée le")</th><th>@L.T("Demandeur")</th><th>@L.T("Sous-réseau")</th><th>@L.T("État")</th><th>@L.T("Adresse attribuée")</th><th>@L.T("Par")</th><th>@L.T("Commentaire")</th></tr></thead>
            <tbody>
                @foreach (IpRequest request in Model.Processed)
                {
                    <tr>
                        <td class="text-nowrap">@request.ProcessedAt?.ToLocalTime().ToString("g")</td>
                        <td>@request.RequesterName</td>
                        <td class="font-monospace">@request.Subnet?.Network</td>
                        <td><span class="badge @(request.State == IpRequestState.Approved ? "text-bg-success" : "text-bg-secondary")">@Html.DisplayFor(_ => request.State)</span></td>
                        <td class="font-monospace">@request.AssignedAddress</td>
                        <td>@(request.ProcessedBy?.DisplayName ?? request.ProcessedBy?.UserName)</td>
                        <td>@request.AdminComment</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
