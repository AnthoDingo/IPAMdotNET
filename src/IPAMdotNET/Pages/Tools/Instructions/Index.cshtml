@page
@model IPAMdotNet.Pages.Tools.Instructions.IndexModel
@{
    ViewData["Title"] = L.T("Instructions");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-info-circle"></i> @L.T("Instructions")</span>
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="Edit" class="btn btn-outline-secondary btn-sm ms-auto"><i class="bi bi-pencil"></i> @L.T("Modifier")</a>
        }
    </div>
    @if (string.IsNullOrWhiteSpace(Model.Text))
    {
        <p class="ipam-empty">@L.T("Aucune instruction n'a été rédigée.")</p>
    }
    else
    {
        <div class="ipam-markdown">@Html.Raw(IPAMdotNet.Maintenance.MarkdownText.ToHtml(Model.Text))</div>
    }
</div>
