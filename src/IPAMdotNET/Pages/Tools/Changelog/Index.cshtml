@page
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Tools.Changelog.IndexModel
@{
    ViewData["Title"] = L.T("Journal des modifications");
}

<div class="ipam-panel">
    <div class="ipam-panel-title"><i class="bi bi-clock-history"></i> @L.T("Journal des modifications")</div>
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <select asp-for="Type" asp-items="Model.Types" class="form-select" aria-label="@L.T("Type d'objet")">
                <option value="">@L.T("Tous les types")</option>
            </select>
        </div>
        <div class="col-md-6">
            <input asp-for="Q" class="form-control" placeholder="@L.T("Utilisateur ou objet")" aria-label="@L.T("Filtre")" />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">@L.T("Filtrer")</button>
        </div>
    </form>

    @if (Model.Rows.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucune modification enregistrée.")</p>
    }
    else
    {
        <table class="table table-sm align-middle mb-2">
            <thead><tr><th>@L.T("Date")</th><th>@L.T("Utilisateur")</th><th>@L.T("Action")</th><th>@L.T("Type")</th><th>@L.T("Objet")</th><th>@L.T("Détail")</th></tr></thead>
            <tbody>
                @foreach (ChangeRow row in Model.Rows)
                {
                    ChangeLog log = row.Log;
                    (string Label, string Page, bool HasDetails) type = ChangeLog.Types.TryGetValue(log.EntityType, out (string, string, bool) known)
                        ? known : (log.EntityType, "/Index", false);
                    string badge = log.Action switch
                    {
                        ChangeAction.Created => "text-bg-success",
                        ChangeAction.Deleted => "text-bg-danger",
                        _ => "text-bg-primary",
                    };
                    <tr>
                        <td class="text-nowrap">@log.Date.ToLocalTime().ToString("g")</td>
                        <td>@log.UserName</td>
                        <td><span class="badge @badge">@Html.DisplayFor(_ => log.Action)</span></td>
                        <td>@type.Label</td>
                        <td>
                            @if (log.Action == ChangeAction.Deleted)
                            {
                                <span class="text-decoration-line-through">@log.EntityLabel</span>
                            }
                            else if (type.HasDetails)
                            {
                                <a asp-page="@type.Page" asp-route-id="@log.EntityId">@log.EntityLabel</a>
                            }
                            else
                            {
                                <a asp-page="@type.Page">@log.EntityLabel</a>
                            }
                        </td>
                        <td>
                            @if (row.Changes.Count > 0)
                            {
                                <details>
                                    <summary>@(L.T("{0} champ(s)", row.Changes.Count))</summary>
                                    <table class="table table-sm table-borderless small mb-0">
                                        @foreach (KeyValuePair<string, string?[]> change in row.Changes)
                                        {
                                            <tr>
                                                <th scope="row">@change.Key</th>
                                                <td class="text-danger">@(change.Value.ElementAtOrDefault(0) ?? "—")</td>
                                                <td><i class="bi bi-arrow-right"></i></td>
                                                <td class="text-success">@(change.Value.ElementAtOrDefault(1) ?? "—")</td>
                                            </tr>
                                        }
                                    </table>
                                </details>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.PageCount > 1)
        {
            <nav aria-label="@L.T("Pages")">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-p="@(Model.PageNumber - 1)" asp-route-type="@Model.Type" asp-route-q="@Model.Q">@L.T("Précédent")</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">@(L.T("Page {0} / {1}", Model.PageNumber, Model.PageCount))</span></li>
                    <li class="page-item @(Model.PageNumber == Model.PageCount ? "disabled" : "")">
                        <a class="page-link" asp-route-p="@(Model.PageNumber + 1)" asp-route-type="@Model.Type" asp-route-q="@Model.Q">@L.T("Suivant")</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
