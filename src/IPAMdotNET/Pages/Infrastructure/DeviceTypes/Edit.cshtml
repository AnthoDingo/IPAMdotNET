@page "{id:int?}"
@model IPAMdotNet.Pages.Infrastructure.DeviceTypes.EditModel
@{
    ViewData["Title"] = Model.DeviceType.Id == 0 ? L.T("Nouveau type d'équipement") : L.T("Type {0}", Model.DeviceType.Name);
}

<div class="ipam-panel ipam-form">
    <div class="ipam-panel-title">@ViewData["Title"]</div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="DeviceType.Name" class="form-label"></label>
            <input asp-for="DeviceType.Name" class="form-control" />
            <span asp-validation-for="DeviceType.Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DeviceType.Description" class="form-label"></label>
            <textarea asp-for="DeviceType.Description" class="form-control" rows="2"></textarea>
            <span asp-validation-for="DeviceType.Description" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">@L.T("Enregistrer")</button>
        <a asp-page="Index" class="btn btn-outline-secondary">@L.T("Annuler")</a>
    </form>
    <partial name="_DeleteForm" model="@(new DeleteForm(Model.DeviceType.Id, L.T("ce type")))" />
</div>
