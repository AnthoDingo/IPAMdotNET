@page
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Infrastructure.Customers.IndexModel
@{
    ViewData["Title"] = L.T("Clients");
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-people"></i> @L.T("Clients")</span>
        @if (admin)
        {
            <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Ajouter")</a>
        }
    </div>
    <partial name="_CustomFieldFilter" model="Model.Custom" />
    @if (Model.Customers.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun client.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Nom")</th><th>@L.T("Ville")</th><th>@L.T("Contact")</th><th>@L.T("Téléphone")</th><th>@L.T("E-mail")</th>@foreach (CustomField field in Model.Custom.Fields) { <th>@field.Name</th> }@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (Customer customer in Model.Customers)
                {
                    <tr>
                        <td><a asp-page="Details" asp-route-id="@customer.Id">@customer.Name</a></td>
                        <td>@customer.City</td>
                        <td>@customer.ContactPerson</td>
                        <td>@customer.ContactPhone</td>
                        <td>@if (customer.ContactMail is not null) { <a href="mailto:@customer.ContactMail">@customer.ContactMail</a> }</td>
                        @foreach (CustomField field in Model.Custom.Fields)
                        {
                            <td>@Model.Custom.Display(customer.Id, field)</td>
                        }
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Edit" asp-route-id="@customer.Id" class="btn btn-outline-secondary btn-sm" title="@L.T("Modifier")"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
