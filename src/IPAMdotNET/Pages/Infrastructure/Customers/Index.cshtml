@page
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Infrastructure.Customers.IndexModel
@{
    ViewData["Title"] = "Clients";
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-people"></i> Clients</span>
        @if (admin)
        {
            <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> Ajouter</a>
        }
    </div>
    @if (Model.Customers.Count == 0)
    {
        <p class="ipam-empty">Aucun client.</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Nom</th><th>Ville</th><th>Contact</th><th>Téléphone</th><th>E-mail</th>@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (Customer customer in Model.Customers)
                {
                    <tr>
                        <td><a asp-page="Details" asp-route-id="@customer.Id">@customer.Name</a></td>
                        <td>@customer.City</td>
                        <td>@customer.ContactPerson</td>
                        <td>@customer.ContactPhone</td>
                        <td>@if (customer.ContactMail is not null) { <a href="mailto:@customer.ContactMail">@customer.ContactMail</a> }</td>
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Edit" asp-route-id="@customer.Id" class="btn btn-outline-secondary btn-sm" title="Modifier"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
