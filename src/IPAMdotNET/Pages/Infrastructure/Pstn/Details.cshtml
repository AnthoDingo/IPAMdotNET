@page "{id:int}"
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Infrastructure.Pstn.DetailsModel
@{
    ViewData["Title"] = L.T("Préfixe {0}", Model.Prefix.Prefix);
    bool admin = User.IsInRole("Admin");
    long capacity = Model.Prefix.Stop - Model.Prefix.Start + 1;
}

<div class="ipam-panel mb-3">
    <div class="ipam-panel-title d-flex align-items-center">
        <span class="font-monospace"><i class="bi bi-telephone"></i> @Model.Prefix.Prefix</span>
        @if (admin)
        {
            <a asp-page="Edit" asp-route-id="@Model.Prefix.Id" class="btn btn-outline-secondary btn-sm ms-auto"><i class="bi bi-pencil"></i> @L.T("Modifier")</a>
        }
    </div>
    <dl class="row mb-0 ipam-details">
        <dt class="col-sm-4 col-xl-3">@L.T("Nom")</dt>
        <dd class="col-sm-8 col-xl-9">@Model.Prefix.Name</dd>
        <dt class="col-sm-4 col-xl-3">@L.T("Plage")</dt>
        <dd class="col-sm-8 col-xl-9 font-monospace">@Model.Prefix.Start – @Model.Prefix.Stop</dd>
        <dt class="col-sm-4 col-xl-3">@L.T("Utilisation")</dt>
        <dd class="col-sm-8 col-xl-9">@L.T("{0} / {1} numéros", Model.NumberCount, capacity.ToString("N0"))</dd>
        <dt class="col-sm-4 col-xl-3">@L.T("Équipement")</dt>
        <dd class="col-sm-8 col-xl-9">@if (Model.Prefix.Device is null) { <text>—</text> } else { <a asp-page="/Infrastructure/Devices/Details" asp-route-id="@Model.Prefix.Device.Id">@Model.Prefix.Device.Hostname</a> }</dd>
        <dt class="col-sm-4 col-xl-3">@L.T("Description")</dt>
        <dd class="col-sm-8 col-xl-9">@(Model.Prefix.Description ?? "—")</dd>
        <partial name="_CustomFieldsDisplay" model="Model.CustomFieldValues" />
    </dl>
</div>

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-list-ol"></i> @L.T("Numéros")</span>
        @if (admin)
        {
            <a asp-page="Numbers/Edit" asp-route-prefixId="@Model.Prefix.Id" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Ajouter")</a>
        }
    </div>
    <partial name="_CustomFieldFilter" model="Model.Custom" />
    @if (Model.Numbers.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun numéro.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Numéro")</th><th>@L.T("Nom")</th><th>@L.T("Titulaire")</th><th>@L.T("État")</th><th>@L.T("Équipement")</th><th>@L.T("Description")</th>@foreach (CustomField field in Model.Custom.Fields) { <th>@field.Name</th> }@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (PstnNumber number in Model.Numbers)
                {
                    <tr>
                        <td class="font-monospace">@Model.Prefix.Prefix @number.Number</td>
                        <td>@number.Name</td>
                        <td>@number.Owner</td>
                        <td>@Html.DisplayFor(_ => number.State)</td>
                        <td>@if (number.Device is not null) { <a asp-page="/Infrastructure/Devices/Details" asp-route-id="@number.Device.Id">@number.Device.Hostname</a> }</td>
                        <td>@number.Description</td>
                        @foreach (CustomField field in Model.Custom.Fields)
                        {
                            <td>@Model.Custom.Display(number.Id, field)</td>
                        }
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Numbers/Edit" asp-route-id="@number.Id" class="btn btn-outline-secondary btn-sm" title="@L.T("Modifier")"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (Model.Prefix.Id != 0)
{
    <vc:history entity-type="PstnPrefix" entity-id="@Model.Prefix.Id" />
}
