@page
@using System.Globalization
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Infrastructure.Pstn.IndexModel
@{
    ViewData["Title"] = L.T("Préfixes RTC");
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-telephone"></i> @L.T("Préfixes RTC")</span>
        @if (admin)
        {
            <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Ajouter")</a>
        }
    </div>
    <partial name="_CustomFieldFilter" model="Model.Custom" />
    @if (Model.Nodes.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun préfixe.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Préfixe")</th><th>@L.T("Nom")</th><th>@L.T("Plage")</th><th class="text-end">@L.T("Numéros")</th><th>@L.T("Équipement")</th><th>@L.T("Description")</th>@foreach (CustomField field in Model.Custom.Fields) { <th>@field.Name</th> }@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (PstnNode node in Model.Nodes)
                {
                    <tr>
                        <td class="font-monospace" style="padding-left: @((node.Depth * 1.25 + 0.25).ToString(CultureInfo.InvariantCulture))rem">
                            @if (node.Depth > 0)
                            {
                                <i class="bi bi-arrow-return-right text-body-secondary"></i>
                            }
                            <a asp-page="Details" asp-route-id="@node.Prefix.Id">@node.Prefix.Prefix</a>
                        </td>
                        <td>@node.Prefix.Name</td>
                        <td class="font-monospace">@node.Prefix.Start – @node.Prefix.Stop</td>
                        <td class="text-end">@node.NumberCount</td>
                        <td>@if (node.Prefix.Device is not null) { <a asp-page="/Infrastructure/Devices/Details" asp-route-id="@node.Prefix.Device.Id">@node.Prefix.Device.Hostname</a> }</td>
                        <td>@node.Prefix.Description</td>
                        @foreach (CustomField field in Model.Custom.Fields)
                        {
                            <td>@Model.Custom.Display(node.Prefix.Id, field)</td>
                        }
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Edit" asp-route-id="@node.Prefix.Id" class="btn btn-outline-secondary btn-sm" title="@L.T("Modifier")"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
