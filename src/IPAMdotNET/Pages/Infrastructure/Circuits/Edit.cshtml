@page "{id:int?}"
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Infrastructure.Circuits.EditModel
@{
    ViewData["Title"] = Model.Circuit.Id == 0 ? "Nouveau circuit" : $"Circuit {Model.Circuit.Cid}";
}

<div class="ipam-panel ipam-form">
    <div class="ipam-panel-title">@ViewData["Title"]</div>
    @if (Model.Providers.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun fournisseur.") <a asp-page="Providers/Edit">@L.T("Créez un fournisseur")</a> @L.T("avant d'ajouter des circuits.")</p>
    }
    else
    {
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Circuit.Cid" class="form-label"></label>
                    <input asp-for="Circuit.Cid" class="form-control font-monospace" />
                    <span asp-validation-for="Circuit.Cid" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Circuit.ProviderId" class="form-label"></label>
                    <select asp-for="Circuit.ProviderId" asp-items="Model.Providers" class="form-select"></select>
                    <span asp-validation-for="Circuit.ProviderId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Circuit.Type" class="form-label"></label>
                    <input asp-for="Circuit.Type" class="form-control" list="circuit-types" placeholder="@L.T("Fibre, MPLS, Internet…")" />
                    <datalist id="circuit-types">
                        <option value="Fibre noire"></option>
                        <option value="Lien Ethernet"></option>
                        <option value="MPLS"></option>
                        <option value="Accès Internet"></option>
                        <option value="Liaison louée"></option>
                    </datalist>
                </div>
                <div class="col-md-4">
                    <label asp-for="Circuit.Capacity" class="form-label"></label>
                    <input asp-for="Circuit.Capacity" class="form-control" placeholder="@L.T("1 Gbit/s")" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Circuit.Status" class="form-label"></label>
                    <select asp-for="Circuit.Status" asp-items="Html.GetEnumSelectList<CircuitStatus>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Circuit.LocationAId" class="form-label"></label>
                    <select asp-for="Circuit.LocationAId" asp-items="Model.Locations" class="form-select"><option value="">@L.T("Aucun")</option></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Circuit.LocationBId" class="form-label"></label>
                    <select asp-for="Circuit.LocationBId" asp-items="Model.Locations" class="form-select"><option value="">@L.T("Aucun")</option></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Circuit.CustomerId" class="form-label"></label>
                    <select asp-for="Circuit.CustomerId" asp-items="Model.Customers" class="form-select"><option value="">@L.T("Aucun")</option></select>
                </div>
                <div class="col-12">
                    <label asp-for="Circuit.Comment" class="form-label"></label>
                    <textarea asp-for="Circuit.Comment" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Circuit.Comment" class="text-danger"></span>
                </div>
            </div>
            <partial name="_CustomFieldsEdit" model="Model.CustomInputs" />
            <button type="submit" class="btn btn-primary">@L.T("Enregistrer")</button>
            <a asp-page="Index" class="btn btn-outline-secondary">@L.T("Annuler")</a>
        </form>
        <partial name="_DeleteForm" model="@(new DeleteForm(Model.Circuit.Id, "ce circuit"))" />
    }
</div>
