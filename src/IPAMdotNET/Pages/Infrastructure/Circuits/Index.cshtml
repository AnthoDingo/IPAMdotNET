@page
@using IPAMdotNet.Data
@using IPAMdotNet.Maintenance
@model IPAMdotNet.Pages.Infrastructure.Circuits.IndexModel
@{
    ViewData["Title"] = "Circuits";
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center gap-2">
        <span><i class="bi bi-plug"></i> Circuits</span>
        <a asp-page="Providers/Index" class="btn btn-outline-secondary btn-sm ms-auto"><i class="bi bi-building"></i> Fournisseurs</a>
        @if (admin)
        {
            <a asp-page="Edit" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Ajouter</a>
        }
    </div>
    @if (Model.Circuits.Count == 0)
    {
        <p class="ipam-empty">Aucun circuit.</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Identifiant</th><th>Fournisseur</th><th>Type</th><th>Capacité</th><th>Statut</th><th>Extrémité A</th><th>Extrémité B</th><th>Client</th>@foreach (CustomField field in Model.CustomFields) { <th>@field.Name</th> }@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (Circuit circuit in Model.Circuits)
                {
                    string badge = circuit.Status switch
                    {
                        CircuitStatus.Active => "text-bg-success",
                        CircuitStatus.Reserved => "text-bg-warning",
                        _ => "text-bg-secondary",
                    };
                    <tr id="circuit-@circuit.Id">
                        <td class="font-monospace">@circuit.Cid</td>
                        <td>@circuit.Provider?.Name</td>
                        <td>@circuit.Type</td>
                        <td>@circuit.Capacity</td>
                        <td><span class="badge @badge">@Html.DisplayFor(_ => circuit.Status)</span></td>
                        <td>
                            @if (circuit.LocationA is not null)
                            {
                                <a asp-page="/Infrastructure/Locations/Details" asp-route-id="@circuit.LocationA.Id">@circuit.LocationA.Name</a>
                            }
                        </td>
                        <td>
                            @if (circuit.LocationB is not null)
                            {
                                <a asp-page="/Infrastructure/Locations/Details" asp-route-id="@circuit.LocationB.Id">@circuit.LocationB.Name</a>
                            }
                        </td>
                        <td>
                            @if (circuit.Customer is not null)
                            {
                                <a asp-page="/Infrastructure/Customers/Details" asp-route-id="@circuit.Customer.Id">@circuit.Customer.Name</a>
                            }
                        </td>
                        @foreach (CustomField field in Model.CustomFields)
                        {
                            <td>@CustomFieldForm.Display(field, Model.CustomValues.GetValueOrDefault(circuit.Id)?.GetValueOrDefault(field.Id))</td>
                        }
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Edit" asp-route-id="@circuit.Id" class="btn btn-outline-secondary btn-sm" title="Modifier"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
