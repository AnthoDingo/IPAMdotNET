@page "{id:int}"
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Infrastructure.Racks.DetailsModel
@{
    ViewData["Title"] = Model.Rack.Name;
    bool admin = User.IsInRole("Admin");
}

<div class="row g-3">
    <div class="col-xl-5">
        <div class="ipam-panel">
            <div class="ipam-panel-title d-flex align-items-center">
                <span><i class="bi bi-hdd-stack"></i> @Model.Rack.Name</span>
                @if (admin)
                {
                    <a asp-page="Edit" asp-route-id="@Model.Rack.Id" class="btn btn-outline-secondary btn-sm ms-auto"><i class="bi bi-pencil"></i> @L.T("Modifier")</a>
                }
            </div>
            <dl class="row mb-0 ipam-details">
                <dt class="col-sm-5">@L.T("Hauteur")</dt>
                <dd class="col-sm-7">@Model.Rack.Size U@(Model.Rack.HasBack ? ", " + L.T("deux faces") : "")</dd>
                <dt class="col-sm-5">@L.T("Numérotation")</dt>
                <dd class="col-sm-7">@(Model.Rack.TopDown ? L.T("U1 en haut") : L.T("U1 en bas"))</dd>
                <dt class="col-sm-5">@L.T("Emplacement")</dt>
                <dd class="col-sm-7">
                    @if (Model.Rack.Location is null) { <text>—</text> }
                    else { <a asp-page="/Infrastructure/Locations/Details" asp-route-id="@Model.Rack.Location.Id">@Model.Rack.Location.Name</a> }
                </dd>
                <dt class="col-sm-5">@L.T("Client")</dt>
                <dd class="col-sm-7">
                    @if (Model.Rack.Customer is null) { <text>—</text> }
                    else { <a asp-page="/Infrastructure/Customers/Details" asp-route-id="@Model.Rack.Customer.Id">@Model.Rack.Customer.Name</a> }
                </dd>
                <dt class="col-sm-5">@L.T("Description")</dt>
                <dd class="col-sm-7">@(Model.Rack.Description ?? "—")</dd>
                <partial name="_CustomFieldsDisplay" model="Model.CustomFieldValues" />
            </dl>
            @if (Model.Unplaced.Count > 0)
            {
                <div class="mt-3">
                    <div class="fw-semibold mb-1">@L.T("Sans position")</div>
                    <ul class="mb-0">
                        @foreach (Device device in Model.Unplaced)
                        {
                            <li>@if (device.Id == 0) { @device.Hostname } else { <a asp-page="/Infrastructure/Devices/Details" asp-route-id="@device.Id">@device.Hostname</a> }</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
    @foreach ((RackFace face, Device?[] units) in Model.Units)
    {
        <div class="@(Model.Rack.HasBack ? "col-md-6 col-xl-3" : "col-xl-7")">
            <div class="ipam-panel">
                <div class="ipam-panel-title"><i class="bi bi-layout-three-columns"></i> @(face == RackFace.Front ? L.T("Face avant") : L.T("Face arrière"))</div>
                <table class="ipam-rack">
                    <tbody>
                        @foreach (int unit in Model.Rack.UnitsTopToBottom)
                        {
                            Device? device = units[unit];
                            // La cellule d'un équipement est posée sur sa première unité affichée (la plus haute à l'écran).
                            int top = device is null ? 0 : Model.Rack.TopDown ? device.RackStart!.Value : Math.Min(device.RackEnd!.Value, Model.Rack.Size);
                            <tr>
                                <th scope="row">@unit</th>
                                @if (device is null)
                                {
                                    <td class="ipam-rack-empty"></td>
                                }
                                else if (unit == top)
                                {
                                    <td class="ipam-rack-device" rowspan="@(Math.Min(device.RackEnd!.Value, Model.Rack.Size) - device.RackStart!.Value + 1)">
                                        <strong>@if (device.Id == 0) { @device.Hostname } else { <a asp-page="/Infrastructure/Devices/Details" asp-route-id="@device.Id">@device.Hostname</a> }</strong>
                                        <span>@device.DeviceType?.Name @device.IpAddress</span>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (Model.Rack.Id != 0)
{
    <vc:history entity-type="Rack" entity-id="@Model.Rack.Id" />
}
