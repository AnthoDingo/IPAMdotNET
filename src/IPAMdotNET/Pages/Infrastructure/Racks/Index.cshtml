@page
@model IPAMdotNet.Pages.Infrastructure.Racks.IndexModel
@{
    ViewData["Title"] = "Racks";
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-hdd-stack"></i> Racks</span>
        @if (admin)
        {
            <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> Ajouter</a>
        }
    </div>
    @if (Model.Racks.Count == 0)
    {
        <p class="ipam-empty">Aucun rack.</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Nom</th><th>Emplacement</th><th>Client</th><th class="text-end">Équipements</th><th style="width: 12rem">Occupation</th><th>Description</th>@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (RackRow row in Model.Racks)
                {
                    int percent = row.UsedUnits * 100 / row.Rack.Size;
                    <tr>
                        <td><a asp-page="Details" asp-route-id="@row.Rack.Id">@row.Rack.Name</a></td>
                        <td>@row.Rack.Location?.Name</td>
                        <td>@row.Rack.Customer?.Name</td>
                        <td class="text-end">@row.DeviceCount</td>
                        <td>
                            <div class="progress" role="progressbar" aria-label="Occupation" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" title="@row.UsedUnits U / @row.Rack.Size U">
                                <div class="progress-bar" style="width: @percent%">@row.UsedUnits / @row.Rack.Size U</div>
                            </div>
                        </td>
                        <td>@row.Rack.Description</td>
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Edit" asp-route-id="@row.Rack.Id" class="btn btn-outline-secondary btn-sm" title="Modifier"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
