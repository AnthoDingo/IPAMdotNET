@page
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Infrastructure.Racks.IndexModel
@{
    ViewData["Title"] = L.T("Racks");
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-hdd-stack"></i> @L.T("Racks")</span>
        @if (admin)
        {
            <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Ajouter")</a>
        }
    </div>
    <partial name="_CustomFieldFilter" model="Model.Custom" />
    @if (Model.Racks.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun rack.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Nom")</th><th>@L.T("Emplacement")</th><th>@L.T("Client")</th><th class="text-end">@L.T("Équipements")</th><th style="width: 12rem">@L.T("Occupation")</th><th>@L.T("Description")</th>@foreach (CustomField field in Model.Custom.Fields) { <th>@field.Name</th> }@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (RackRow row in Model.Racks)
                {
                    int percent = row.UsedUnits * 100 / row.Rack.Size;
                    <tr>
                        <td><a asp-page="Details" asp-route-id="@row.Rack.Id">@row.Rack.Name</a></td>
                        <td>@row.Rack.Location?.Name</td>
                        <td>@row.Rack.Customer?.Name</td>
                        <td class="text-end">@row.DeviceCount</td>
                        <td>
                            <div class="progress" role="progressbar" aria-label="@L.T("Occupation")" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" title="@row.UsedUnits U / @row.Rack.Size U">
                                <div class="progress-bar" style="width: @percent%">@row.UsedUnits / @row.Rack.Size U</div>
                            </div>
                        </td>
                        <td>@row.Rack.Description</td>
                        @foreach (CustomField field in Model.Custom.Fields)
                        {
                            <td>@Model.Custom.Display(row.Rack.Id, field)</td>
                        }
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Edit" asp-route-id="@row.Rack.Id" class="btn btn-outline-secondary btn-sm" title="@L.T("Modifier")"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
