@page
@using IPAMdotNet.Data
@using IPAMdotNet.Maintenance
@model IPAMdotNet.Pages.Infrastructure.Devices.IndexModel
@{
    ViewData["Title"] = L.T("Équipements");
    bool admin = User.IsInRole("Admin");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-hdd"></i> @L.T("Équipements")</span>
        @if (admin)
        {
            <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Ajouter")</a>
        }
    </div>
    <partial name="_CustomFieldFilter" model="Model.Custom" />
    @if (Model.Devices.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun équipement.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Nom d'hôte")</th><th>@L.T("Adresse IP")</th><th>@L.T("Type")</th><th>@L.T("Emplacement")</th><th>@L.T("Rack")</th><th>@L.T("Client")</th><th>@L.T("Description")</th>@foreach (CustomField field in Model.Custom.Fields) { <th>@field.Name</th> }@if (admin) { <th></th> }</tr></thead>
            <tbody>
                @foreach (Device device in Model.Devices)
                {
                    <tr id="device-@device.Id">
                        <td><a asp-page="Details" asp-route-id="@device.Id">@device.Hostname</a></td>
                        <td class="font-monospace">@device.IpAddress</td>
                        <td>@device.DeviceType?.Name</td>
                        <td>
                            @if (device.Location is not null)
                            {
                                <a asp-page="/Infrastructure/Locations/Details" asp-route-id="@device.Location.Id">@device.Location.Name</a>
                            }
                        </td>
                        <td>
                            @if (device.Rack is not null)
                            {
                                <a asp-page="/Infrastructure/Racks/Details" asp-route-id="@device.Rack.Id">@device.Rack.Name</a>
                                @if (device.RackStart is not null)
                                {
                                    <span class="text-body-secondary">U@(device.RackStart)@(device.RackSize > 1 ? $"–{device.RackEnd}" : "")@(device.RackFace == RackFace.Back ? " " + L.T("(arrière)") : "")</span>
                                }
                            }
                        </td>
                        <td>
                            @if (device.Customer is not null)
                            {
                                <a asp-page="/Infrastructure/Customers/Details" asp-route-id="@device.Customer.Id">@device.Customer.Name</a>
                            }
                        </td>
                        <td>@device.Description</td>
                        @foreach (CustomField field in Model.Custom.Fields)
                        {
                            <td>@Model.Custom.Display(device.Id, field)</td>
                        }
                        @if (admin)
                        {
                            <td class="text-end"><a asp-page="Edit" asp-route-id="@device.Id" class="btn btn-outline-secondary btn-sm" title="@L.T("Modifier")"><i class="bi bi-pencil"></i></a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
