@page "{id:int?}"
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Administration.CustomFields.EditModel
@{
    ViewData["Title"] = Model.Field.Id == 0 ? "Nouveau champ personnalisé" : $"Champ {Model.Field.Name}";
}

<div class="ipam-panel ipam-form">
    <div class="ipam-panel-title">@ViewData["Title"]</div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Field.EntityType" class="form-label"></label>
                <select asp-for="Field.EntityType" asp-items="Model.EntityTypes" class="form-select" disabled="@(Model.Field.Id != 0)"></select>
                @if (Model.Field.Id != 0)
                {
                    <input type="hidden" asp-for="Field.EntityType" />
                }
                <span asp-validation-for="Field.EntityType" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Field.Name" class="form-label"></label>
                <input asp-for="Field.Name" class="form-control" />
                <span asp-validation-for="Field.Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Field.Type" class="form-label"></label>
                <select asp-for="Field.Type" asp-items="Html.GetEnumSelectList<CustomFieldType>()" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="Field.Order" class="form-label"></label>
                <input asp-for="Field.Order" class="form-control" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="Field.Required" class="form-check-input" />
                    <label asp-for="Field.Required" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Field.Options" class="form-label"></label>
                <textarea asp-for="Field.Options" class="form-control" rows="4" placeholder="Un choix par ligne (type « Liste de choix » uniquement)"></textarea>
                <span asp-validation-for="Field.Options" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Field.Description" class="form-label"></label>
                <input asp-for="Field.Description" class="form-control" placeholder="Texte d'aide affiché sous le champ" />
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Annuler</a>
    </form>
    <partial name="_DeleteForm" model="@(new DeleteForm(Model.Field.Id, "ce champ et toutes ses valeurs"))" />
</div>
