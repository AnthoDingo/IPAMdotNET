@page
@model IPAMdotNet.Pages.Administration.Groups.IndexModel
@{
    ViewData["Title"] = L.T("Groupes");
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-people"></i> @L.T("Groupes")</span>
        <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> @L.T("Ajouter")</a>
    </div>
    <p class="text-body-secondary">@L.T("Les groupes donnent aux utilisateurs non administrateurs l'accès en lecture ou en écriture à des sections, en plus de l'accès par défaut de chaque section.")</p>
    @if (Model.Groups.Count == 0)
    {
        <p class="ipam-empty">@L.T("Aucun groupe.")</p>
    }
    else
    {
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>@L.T("Nom")</th><th>@L.T("Description")</th><th class="text-end">@L.T("Membres")</th><th class="text-end">@L.T("Sections")</th><th></th></tr></thead>
            <tbody>
                @foreach (GroupRow row in Model.Groups)
                {
                    <tr>
                        <td>@row.Group.Name</td>
                        <td>@row.Group.Description</td>
                        <td class="text-end">@row.MemberCount</td>
                        <td class="text-end">@row.PermissionCount</td>
                        <td class="text-end"><a asp-page="Edit" asp-route-id="@row.Group.Id" class="btn btn-outline-secondary btn-sm" title="@L.T("Modifier")"><i class="bi bi-pencil"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
