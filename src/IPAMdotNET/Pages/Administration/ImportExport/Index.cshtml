@page
@using IPAMdotNet.Maintenance
@model IPAMdotNet.Pages.Administration.ImportExport.IndexModel
@{
    ViewData["Title"] = "Import / export";
}

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="row g-3">
    <div class="col-xl-5">
        <div class="ipam-panel h-100">
            <div class="ipam-panel-title"><i class="bi bi-download"></i> Export CSV</div>
            <p class="text-body-secondary">Séparateur « ; », encodage UTF-8 : le fichier s'ouvre directement dans Excel et peut être réimporté.</p>
            <ul class="list-unstyled mb-0">
                @foreach (CsvFormat format in CsvTransfer.Formats)
                {
                    <li class="mb-1">
                        <a asp-page-handler="Export" asp-route-format="@format.Key" class="btn btn-outline-secondary btn-sm"><i class="bi bi-filetype-csv"></i>@format.Label</a>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-xl-7">
        <div class="ipam-panel h-100">
            <div class="ipam-panel-title"><i class="bi bi-upload"></i> Import CSV</div>
            <form method="post" enctype="multipart/form-data" asp-page-handler="Preview">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="row g-2 mb-2">
                    <div class="col-md-5">
                        <label asp-for="Format" class="form-label"></label>
                        <select asp-for="Format" asp-items="Model.FormatItems" class="form-select"></select>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Upload" class="form-label"></label>
                        <input asp-for="Upload" type="file" accept=".csv,text/csv" class="form-control" />
                        <span asp-validation-for="Upload" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Vérifier le fichier</button>
            </form>
            <hr />
            <div class="small text-body-secondary">
                <div class="fw-semibold mb-1">Colonnes attendues (première ligne)</div>
                @foreach (CsvFormat format in CsvTransfer.Formats)
                {
                    <div><strong>@format.Label</strong> : <span class="font-monospace">@string.Join(";", format.Columns)</span></div>
                }
                <div class="mt-1">Les références (section, VLAN, VRF, type, emplacement) doivent déjà exister. L'import est refusé en entier à la moindre erreur.</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Result is not null)
{
    <div class="ipam-panel mt-3">
        <div class="ipam-panel-title">Aperçu : @Model.Result.RowCount ligne(s)</div>
        @if (Model.Result.Errors.Count > 0)
        {
            <div class="alert alert-danger">
                <div class="fw-semibold mb-1">@Model.Result.Errors.Count erreur(s) : rien n'a été importé.</div>
                <ul class="mb-0">
                    @foreach (string error in Model.Result.Errors.Take(100))
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <form method="post" asp-page-handler="Import" class="mb-3">
                <input type="hidden" asp-for="Format" />
                <input type="hidden" asp-for="CsvText" />
                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i>Importer @Model.Result.Entities.Count objet(s)</button>
            </form>
        }
        <div class="table-responsive">
            <table class="table table-sm small mb-0">
                @foreach (string[] row in Model.PreviewRows)
                {
                    <tr>
                        @foreach (string cell in row)
                        {
                            <td>@cell</td>
                        }
                    </tr>
                }
            </table>
        </div>
        @if (Model.Result.RowCount > 20)
        {
            <p class="text-body-secondary small mb-0">… 20 premières lignes affichées.</p>
        }
    </div>
}
