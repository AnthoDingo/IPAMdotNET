@page
@model IPAMdotNet.Pages.Administration.Verify.IndexModel
@{
    ViewData["Title"] = L.T("Vérifier la base");
}

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="ipam-panel mb-3">
    <div class="ipam-panel-title"><i class="bi bi-database-check"></i> @L.T("Schéma")</div>
    <dl class="row mb-0 ipam-details">
        <dt class="col-sm-4 col-xl-3">@L.T("Moteur")</dt>
        <dd class="col-sm-8 col-xl-9 font-monospace">@Model.Provider</dd>
        <dt class="col-sm-4 col-xl-3">@L.T("Migrations appliquées")</dt>
        <dd class="col-sm-8 col-xl-9">
            @Model.AppliedMigrations.Count
            @if (Model.AppliedMigrations.Count > 0)
            {
                <span class="text-body-secondary font-monospace">@(L.T("(dernière : {0})", Model.AppliedMigrations[^1]))</span>
            }
        </dd>
        <dt class="col-sm-4 col-xl-3">@L.T("Migrations en attente")</dt>
        <dd class="col-sm-8 col-xl-9">
            @if (Model.PendingMigrations.Count == 0)
            {
                <span class="text-success"><i class="bi bi-check-circle"></i>@L.T("Aucune, le schéma est à jour.")</span>
            }
            else
            {
                <span class="text-danger">@string.Join(", ", Model.PendingMigrations)</span>
            }
        </dd>
    </dl>
</div>

@foreach (CheckResult check in Model.Checks)
{
    <div class="ipam-panel mb-3">
        <div class="ipam-panel-title d-flex align-items-center">
            @if (check.Problems.Count == 0)
            {
                <span><i class="bi bi-check-circle text-success"></i> @check.Title</span>
                <span class="badge text-bg-success ms-auto">OK</span>
            }
            else
            {
                <span><i class="bi bi-exclamation-triangle text-warning"></i> @check.Title</span>
                <span class="badge text-bg-warning ms-auto">@(L.T("{0} anomalie(s)", check.Problems.Count))</span>
            }
        </div>
        <p class="text-body-secondary mb-2">@check.Description</p>
        @if (check.Problems.Count > 0)
        {
            <ul class="mb-2">
                @foreach (string problem in check.Problems.Take(50))
                {
                    <li>@problem</li>
                }
            </ul>
            @if (check.FixHandler is not null)
            {
                <form method="post" asp-page-handler="@check.FixHandler" onsubmit="return confirm('Corriger automatiquement ?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-wrench"></i>@L.T("Corriger")</button>
                </form>
            }
        }
    </div>
}
