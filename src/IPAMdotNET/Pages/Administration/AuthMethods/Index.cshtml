@page
@model IPAMdotNet.Pages.Administration.AuthMethods.IndexModel
@{
    ViewData["Title"] = "Méthodes d'authentification";
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-shield-lock"></i> Méthodes d'authentification</span>
        <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> Ajouter un annuaire LDAP / AD</a>
    </div>
    <p class="text-body-secondary">Chaque utilisateur est rattaché à une méthode dans sa fiche. Le compte doit exister dans IPAMdotNet (droits, groupes) ; seul le mot de passe est vérifié par l'annuaire.</p>
    <table class="table table-sm table-hover align-middle mb-0">
        <thead><tr><th>Nom</th><th>Type</th><th>Serveur</th><th>Modèle d'identifiant</th><th class="text-end">Utilisateurs</th><th></th></tr></thead>
        <tbody>
            <tr>
                <td>Locale</td>
                <td>Mot de passe IPAMdotNet</td>
                <td>—</td>
                <td>—</td>
                <td class="text-end">@Model.LocalUserCount</td>
                <td></td>
            </tr>
            @foreach (AuthMethodRow row in Model.Methods)
            {
                <tr>
                    <td>@row.Method.Name</td>
                    <td>LDAP@(row.Method.UseSsl ? "S" : "")</td>
                    <td class="font-monospace">@row.Method.Host:@row.Method.Port</td>
                    <td class="font-monospace">@row.Method.BindTemplate</td>
                    <td class="text-end">@row.UserCount</td>
                    <td class="text-end"><a asp-page="Edit" asp-route-id="@row.Method.Id" class="btn btn-outline-secondary btn-sm" title="Modifier"><i class="bi bi-pencil"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
