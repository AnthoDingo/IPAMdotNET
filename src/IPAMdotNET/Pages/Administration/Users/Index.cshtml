@page
@using IPAMdotNet.Data
@model IPAMdotNet.Pages.Administration.Users.IndexModel
@{
    ViewData["Title"] = "Utilisateurs";
}

<div class="ipam-panel">
    <div class="ipam-panel-title d-flex align-items-center">
        <span><i class="bi bi-person"></i> Utilisateurs</span>
        <a asp-page="Edit" class="btn btn-primary btn-sm ms-auto"><i class="bi bi-plus-lg"></i> Ajouter</a>
    </div>
    <table class="table table-sm table-hover align-middle mb-0">
        <thead><tr><th>Nom d'utilisateur</th><th>Nom affiché</th><th>E-mail</th><th>Rôle</th><th>Authentification</th><th>Groupes</th><th>État</th><th></th></tr></thead>
        <tbody>
            @foreach (User user in Model.Users)
            {
                <tr>
                    <td class="font-monospace">@user.UserName</td>
                    <td>@user.DisplayName</td>
                    <td>@user.Email</td>
                    <td>@if (user.IsAdmin) { <span class="badge text-bg-primary">Admin</span> } else { <text>Utilisateur</text> }</td>
                    <td>@(user.AuthMethod?.Name ?? "Locale")</td>
                    <td>@string.Join(", ", user.Groups.OrderBy(g => g.Name).Select(g => g.Name))</td>
                    <td>@if (user.Enabled) { <span class="badge text-bg-success">Actif</span> } else { <span class="badge text-bg-secondary">Désactivé</span> }</td>
                    <td class="text-end"><a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-outline-secondary btn-sm" title="Modifier"><i class="bi bi-pencil"></i></a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
