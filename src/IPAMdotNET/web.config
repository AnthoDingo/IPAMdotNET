<?xml version="1.0" encoding="utf-8"?>
<!-- IIS : la section aspNetCore est ajoutée par la publication. Limite d'envoi relevée pour les archives de mise à jour
     (Administration › Mise à jour, 512 Mo comme IndexModel.MaxArchiveSize ; 30 Mo par défaut). -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="536870912" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
